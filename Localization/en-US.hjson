Mods: {
	ChainsawManMod: {
		Items: {
			PochitasHeart: {
				DisplayName: Pochita's Heart
				Tooltip:
					'''
					{0}% increased melee damage
					Melee hits drink your enemies' blood, healing you
					Pochita saves you from death once every {1} minutes
					"Pochita... I'll be your heart."
					'''
			}

			StarterCord: {
				DisplayName: Starter Cord
				Tooltip:
					'''
					Use to transform into the Chainsaw Devil; use again to turn back
					Form: +{0}% melee damage, +{1}% melee speed, +{2} defense, +{3}% movement speed
					The form lasts until you turn it off, with no cooldown
					While transformed you get ability items; higher tiers unlock more
					Requires Pochita's Heart to be equipped
					'''
			}

			RevvedStarterCord: {
				DisplayName: Revved Starter Cord
				Tooltip:
					'''
					An upgraded Starter Cord
					Use to transform into the Chainsaw Devil; use again to turn back
					Form: +{0}% melee damage, +{1}% melee speed, +{2} defense, +{3}% movement speed
					The form lasts until you turn it off, with no cooldown
					While transformed you get ability items; higher tiers unlock more
					Requires Pochita's Heart to be equipped
					'''
			}

			HeroOfHellsCord: {
				DisplayName: Hero of Hell's Cord
				Tooltip:
					'''
					The fully upgraded Starter Cord
					Use to transform into the Chainsaw Devil; use again to turn back
					Form: +{0}% melee damage, +{1}% melee speed, +{2} defense, +{3}% movement speed
					The form lasts until you turn it off, with no cooldown
					While transformed you get ability items; higher tiers unlock more
					Requires Pochita's Heart to be equipped
					'''
			}

			ChainsawArm: {
				DisplayName: Chainsaw Arm
				Tooltip:
					'''
					Rip and tear
					Shreds enemies' defense with Ichor and sets them on fire
					Grows stronger after defeating Skeletron, the Wall of Flesh, a mechanical boss, Plantera and the Moon Lord
					Deals 1.5x / 2x / 2.5x damage in Chainsaw Devil form (by Starter Cord tier)
					'''
			}

			PochitaDoll: {
				DisplayName: Pochita Doll
				Tooltip: Summons Pochita to follow you
			}

			DevilFlesh: {
				DisplayName: Devil Flesh
				Tooltip: Still twitching...
			}

			RottingOffering: {
				DisplayName: Rotting Offering
				Tooltip: Summons the Zombie Devil
			}

			BloodyBatFang: {
				DisplayName: Bloody Bat Fang
				Tooltip:
					'''
					Summons the Bat Devil
					Only works in Hardmode
					'''
			}

			GunDevilFragment: {
				DisplayName: Gun Devil Fragment
				Tooltip: It's still warm, and it smells of gunpowder
			}

			CursedHotelKey: {
				DisplayName: Cursed Hotel Key
				Tooltip:
					'''
					Summons the Eternity Devil
					Only works in Hardmode
					'''
			}

			GunDevilsTrigger: {
				DisplayName: Gun Devil's Trigger
				Tooltip:
					'''
					Summons the Gun Devil
					Only works after Plantera has been defeated
					'''
			}

			MakimasContract: {
				DisplayName: Makima's Contract
				Tooltip:
					'''
					Summons Makima
					Only works after the Moon Lord has been defeated
					'''
			}

			ChainsawSlash: {
				DisplayName: Chainsaw Slash
				Tooltip:
					'''
					Chainsaw Devil ability
					Huge, fast swings with your arm chainsaws
					Lowers enemy defense
					'''
			}

			RevDash: {
				DisplayName: Rev Dash
				Tooltip:
					'''
					Chainsaw Devil ability
					Dash toward the cursor, shredding everything in your path
					You can't be hurt during the dash
					'''
			}

			BloodDrink: {
				DisplayName: Blood Drink
				Tooltip:
					'''
					Chainsaw Devil ability
					Heals {0}% of your max health
					{1} second cooldown
					'''
			}

			ChainHook: {
				DisplayName: Chain Hook
				Tooltip:
					'''
					Chainsaw Devil ability (tier 2 cord or higher)
					Fire a chain that pulls you to whatever it hits
					'''
			}

			ChainsawStorm: {
				DisplayName: Chainsaw Storm
				Tooltip:
					'''
					Chainsaw Devil ability (tier 3 cord)
					Surround yourself with spinning chainsaw blades for 6 seconds
					'''
			}
		}

		Buffs: {
			ChainsawDevilForm: {
				DisplayName: Chainsaw Devil
				Description:
					'''
					{0}% increased melee damage, {1}% increased melee speed
					{2} defense, {3}% increased movement speed
					Melee hits drink much more blood
					Pull the cord again to turn back
					Ability items appear in your inventory while transformed
					'''
