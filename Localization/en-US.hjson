			}

			ArrowBarrage: {
				DisplayName: Arrow Barrage
				Tooltip:
					'''
					Bow form ability
					Fire a fan of five arrows
					'''
			}

			PiercingShot: {
				DisplayName: Piercing Shot
				Tooltip:
					'''
					Bow form ability
					A heavy arrow that goes through walls and up to 10 enemies
					'''
			}

			FlameBreath: {
				DisplayName: Flame Breath
				Tooltip:
					'''
					Flamethrower form ability
					Hold to breathe a stream of fire
					Sets enemies on fire
					'''
			}

			FireWall: {
				DisplayName: Fire Wall
				Tooltip:
					'''
					Flamethrower form ability
					Raise a wall of fire pillars in front of you
					'''
			}

			SwordSlash: {
				DisplayName: Sword Slash
				Tooltip:
					'''
					Sword form ability
					Heavy, wide sword swings
					'''
			}

			BladeEruption: {
				DisplayName: Blade Eruption
				Tooltip:
					'''
					Sword form ability
					Blades burst out of the ground at the cursor
					'''
			}

			SpearThrust: {
				DisplayName: Spear Thrust
				Tooltip:
					'''
					Spear form ability
					Launch a spear through a line of enemies
					'''
			}

			SpearRain: {
				DisplayName: Spear Rain
				Tooltip:
					'''
					Spear form ability
					Spears rain down around the cursor
					'''
			}

			WhipCrack: {
				DisplayName: Whip Crack
				Tooltip:
					'''
					Whip form ability
					Crack the whip toward the cursor, hitting everything along it
					'''
			}

			WhipGrab: {
				DisplayName: Whip Grab
				Tooltip:
					'''
					Whip form ability
					A shorter crack that drags ordinary enemies toward you
					Doesn't move bosses
					'''
			}

			ChainsawSlash: {
				DisplayName: Chainsaw Slash
				Tooltip:
					'''
					Chainsaw Devil ability
					Huge, fast swings with your arm chainsaws
					Lowers enemy defense
					'''
			}

			RevDash: {
				DisplayName: Rev Dash
				Tooltip:
					'''
					Chainsaw Devil ability
					Dash toward the cursor, shredding everything in your path
					You can't be hurt during the dash
					'''
			}

			BloodDrink: {
				DisplayName: Blood Drink
				Tooltip:
