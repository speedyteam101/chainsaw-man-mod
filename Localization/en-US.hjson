			BombBlast: {
				DisplayName: Bomb Blast
				Tooltip:
					'''
					Bomb form ability
					Explode around yourself
					Can't hurt you
					'''
			}

			ExplosivePunch: {
				DisplayName: Explosive Punch
				Tooltip:
					'''
					Bomb form ability
					Punch a blast of force that explodes on contact
					'''
			}

			TorpedoDash: {
				DisplayName: Torpedo Dash
				Tooltip:
					'''
					Bomb form ability
					Blast yourself toward the cursor and explode at the end
					You can't be hurt during the dash
					'''
			}

			KatanaSlash: {
				DisplayName: Katana Slash
				Tooltip:
					'''
					Katana form ability
					Very fast swings with your arm blades
					'''
			}

			QuickDraw: {
				DisplayName: Quick Draw
				Tooltip:
					'''
					Katana form ability
					Dash through enemies toward the cursor, cutting everything in your path
					You can't be hurt during the dash
					'''
			}

			SlashWave: {
				DisplayName: Slash Wave
				Tooltip:
					'''
					Katana form ability
					Throw a crescent-shaped cut that flies through enemies
