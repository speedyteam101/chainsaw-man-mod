{
  "name": "Shadowfall",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "GameSettingsAvatar": "R6",
        "CharacterWalkSpeed": 16,
        "EnableMouseLockOption": false,
        "CameraMode": "LockFirstPerson"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$path": "src/character"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "FallenPartsDestroyHeight": -400
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 0,
        "Brightness": 0.4,
        "GlobalShadows": true
      }
    },
    "SoundService": {},
    "StarterGui": {}
  }
}
