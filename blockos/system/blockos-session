#!/bin/sh
# BlockOS X session: Openbox as the window manager, the shell server, and the
# BlockOS desktop shown full screen in a kiosk Chromium window.
# Started by LightDM through /usr/share/xsessions/blockos.desktop.

SHELL_DIR=/opt/blockos/shell
PORT=8737
PROFILE="$HOME/.config/blockos/shell-browser"
mkdir -p "$PROFILE"

# No screen blanking while you play.
xset s off s noblank -dpms 2>/dev/null
xsetroot -solid "#16181b" 2>/dev/null

# Clipboard sharing and automatic screen resizing in UTM/QEMU (SPICE guest agent).
command -v spice-vdagent >/dev/null 2>&1 && spice-vdagent

openbox &

python3 "$SHELL_DIR/server.py" --port "$PORT" &

# Wait (up to 5 s) until the server accepts connections.
i=0
while [ $i -lt 50 ]; do
  python3 -c "import socket; socket.create_connection(('127.0.0.1', $PORT), 0.2)" 2>/dev/null && break
  sleep 0.1
  i=$((i + 1))
done

# After a hard power-off Chromium thinks it crashed and offers to restore pages; mark it clean.
PREFS="$PROFILE/Default/Preferences"
[ -f "$PREFS" ] && sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' "$PREFS"

# Extra Chromium flags can go in /etc/blockos/browser-flags (one line), e.g. --disable-gpu
EXTRA_FLAGS=""
[ -r /etc/blockos/browser-flags ] && EXTRA_FLAGS=$(cat /etc/blockos/browser-flags)

# If the desktop window is ever closed or crashes, bring it straight back.
while true; do
  # shellcheck disable=SC2086
  chromium --kiosk --no-first-run --noerrdialogs --disable-infobars \
    --disable-session-crashed-bubble --disable-features=Translate \
    --password-store=basic --autoplay-policy=no-user-gesture-required \
    --user-data-dir="$PROFILE" --class=BlockOS $EXTRA_FLAGS \
    "http://127.0.0.1:$PORT/"
  sleep 1
done
