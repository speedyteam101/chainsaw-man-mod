      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Every tunable number in Aura Farm lives here.

	This module is plain Luau (no Roblox types) so the pure game logic can be
	unit tested outside Roblox. Colors are {R, G, B} arrays (0-255).
]]

local Config = {}

---------------------------------------------------------------------------
-- Aura ranks (lowest first). You hold the highest rank whose Min you meet.
-- Villains see EvilName instead of Name.
---------------------------------------------------------------------------
Config.Ranks = {
	{ Name = "NPC", EvilName = "Minion", Min = 0, Color = { 170, 170, 170 } },
	{ Name = "Background Character", EvilName = "Henchman", Min = 100, Color = { 120, 200, 255 } },
	{ Name = "Side Character", EvilName = "Enforcer", Min = 500, Color = { 90, 255, 160 } },
	{ Name = "Rival", EvilName = "Nemesis", Min = 1500, Color = { 255, 230, 80 } },
	{ Name = "Main Character", EvilName = "Main Villain", Min = 4000, Color = { 255, 150, 40 } },
	{ Name = "Protagonist", EvilName = "Overlord", Min = 10000, Color = { 255, 70, 70 } },
	{ Name = "Legend", EvilName = "Calamity", Min = 25000, Color = { 200, 90, 255 } },
	{ Name = "Aura God", EvilName = "Demon King", Min = 60000, Color = { 255, 255, 255 } },
}

---------------------------------------------------------------------------
-- Heroic lines (Good side and undecided players). Villains use
-- Config.VillainLines further down.
--   Aura:      base aura for saying it.
--   Condition: optional situation that makes it hit much harder:
--     "FoeLow"     the boss you're fighting, or an enemy player near you,
--                  is below 25% health
--     "LowHealth"  you are below 30% health
--     "AfterDodge" you perfect-dodged in the last 4 seconds
--     "AfterHit"   you took a hit in the last 4 seconds
--     "AfterKill"  you defeated an enemy player in the last 5 seconds
--     "NoFight"    you're not in a fight (pre-fight trash talk)
--   Bonus:     multiplier applied when the Condition is met.
---------------------------------------------------------------------------
Config.HeroicLines = {
	{ Id = "notHere", Text = "I won't lose. Not here. Not now.", Aura = 15, Condition = "LowHealth", Bonus = 3 },
	{ Id = "standBack", Text = "Stand back. I'll handle this.", Aura = 10, Condition = "NoFight", Bonus = 2 },
	{ Id = "wrongHero", Text = "You picked the wrong hero to fight.", Aura = 20 },
	{ Id = "friends", Text = "My friends are my power!", Aura = 15 },
	{ Id = "endsNow", Text = "This ends now.", Aura = 10, Condition = "FoeLow", Bonus = 4 },
	{ Id = "thatsAll", Text = "Is that all you've got?", Aura = 15, Condition = "AfterHit", Bonus = 3 },
	{ Id = "neverBackDown", Text = "I never back down.", Aura = 10 },
	{ Id = "getBackUp", Text = "Even if I fall, I'll get back up.", Aura = 20, Condition = "LowHealth", Bonus = 2 },
	{ Id = "beyondLimits", Text = "Today, I go beyond my limits!", Aura = 25 },
	{ Id = "yourMistake", Text = "You hurt the people I care about. That was your mistake.", Aura = 30 },
	{ Id = "notTrying", Text = "I'm not even trying yet.", Aura = 25, Condition = "AfterDodge", Bonus = 2 },
	{ Id = "getBehindMe", Text = "Get behind me.", Aura = 10, Condition = "NoFight", Bonus = 2 },
	{ Id = "fightForAll", Text = "I fight for everyone who can't.", Aura = 25 },
	{ Id = "rememberName", Text = "Remember my name.", Aura = 20, Condition = "FoeLow", Bonus = 3 },
	{ Id = "oneMoreRound", Text = "One more round.", Aura = 10, Condition = "LowHealth", Bonus = 3 },
	{ Id = "heroShowsUp", Text = "The hero always shows up.", Aura = 15, Condition = "NoFight", Bonus = 2 },
	{ Id = "myTurn", Text = "It's my turn now.", Aura = 15, Condition = "AfterDodge", Bonus = 3 },
	{ Id = "nothingStops", Text = "Nothing can stop me.", Aura = 15 },
	{ Id = "cameThisFar", Text = "I didn't come this far to quit.", Aura = 20, Condition = "LowHealth", Bonus = 2 },
	{ Id = "watchClosely", Text = "Watch closely. This is how it's done.", Aura = 25, Condition = "FoeLow", Bonus = 2 },
	{ Id = "tooSlow", Text = "Too slow.", Aura = 10, Condition = "AfterDodge", Bonus = 4 },
	{ Id = "barelyScratch", Text = "That barely scratched me.", Aura = 15, Condition = "AfterHit", Bonus = 3 },
	{ Id = "justiceServed", Text = "Justice is served.", Aura = 15, Condition = "AfterKill", Bonus = 3 },
	{ Id = "stayDown", Text = "Stay down.", Aura = 10, Condition = "AfterKill", Bonus = 4 },
}

-- Villain lines: same rules as the heroic lines, for the Evil side.
Config.VillainLines = {
	{ Id = "neverThreat", Text = "You were never a threat to me.", Aura = 20 },
	{ Id = "kneel", Text = "Kneel.", Aura = 10, Condition = "FoeLow", Bonus = 4 },
	{ Id = "bestHeroes", Text = "Is this the best your heroes can do?", Aura = 15, Condition = "AfterDodge", Bonus = 3 },
	{ Id = "pathetic", Text = "Pathetic.", Aura = 10, Condition = "AfterDodge", Bonus = 4 },
	{ Id = "hopeEnds", Text = "Your hope ends here.", Aura = 15, Condition = "FoeLow", Bonus = 3 },
	{ Id = "letYouHit", Text = "I let you hit me.", Aura = 15, Condition = "AfterHit", Bonus = 3 },
	{ Id = "painStronger", Text = "Pain only makes me stronger.", Aura = 20, Condition = "AfterHit", Bonus = 2 },
	{ Id = "runWhileYouCan", Text = "Run while you still can.", Aura = 10, Condition = "NoFight", Bonus = 2 },
	{ Id = "worldBows", Text = "This world will bow to me.", Aura = 25 },
	{ Id = "heroOnce", Text = "I was the hero once.", Aura = 25 },
	{ Id = "darknessWins", Text = "Darkness always wins.", Aura = 15 },
	{ Id = "mercyWeak", Text = "Mercy is for the weak.", Aura = 20 },
	{ Id = "alreadyWon", Text = "I've already won. You just don't know it yet.", Aura = 30 },
	{ Id = "nobodyComing", Text = "Nobody is coming to save you.", Aura = 20, Condition = "FoeLow", Bonus = 2 },
	{ Id = "anotherFalls", Text = "Another one falls.", Aura = 15, Condition = "AfterKill", Bonus = 3 },
	{ Id = "whosNext", Text = "Who's next?", Aura = 10, Condition = "AfterKill", Bonus = 4 },
	{ Id = "whatsComing", Text = "You can't stop what's coming.", Aura = 15, Condition = "NoFight", Bonus = 2 },
	{ Id = "evenBroken", Text = "Even broken, I am stronger than you.", Aura = 20, Condition = "LowHealth", Bonus = 3 },
	{ Id = "fearMe", Text = "Fear me.", Aura = 10 },
	{ Id = "lightFading", Text = "Your light is fading.", Aura = 20, Condition = "FoeLow", Bonus = 2 },
	{ Id = "iDontLose", Text = "I don't lose.", Aura = 15, Condition = "LowHealth", Bonus = 3 },
	{ Id = "newRuler", Text = "Bow before your new ruler.", Aura = 25 },
}

-- A message counts as a heroic line when at least this fraction of the
-- line's words appear in it (so small typos / missing words still count).
Config.LineMatchThreshold = 0.75

-- Freestyle: a message that isn't a known line but uses heroic words still
-- earns a little aura (per keyword, capped). Needs at least MinKeywords.
Config.Freestyle = {
	MinKeywords = 2,
	AuraPerKeyword = 4,
	MaxAura = 16,
	Keywords = {
		"protect", "never", "hero", "friends", "believe", "destiny", "promise",
		"power", "fight", "limit", "limits", "end", "defeat", "win", "strong",
		"stronger", "courage", "justice", "everyone", "unstoppable", "legend",
		"rise", "stand", "glory", "brave", "fear", "surrender",
	},
}

-- Freestyle words for villains.
Config.VillainFreestyle = {
	MinKeywords = 2,
	AuraPerKeyword = 4,
	MaxAura = 16,
	Keywords = {
		"weak", "kneel", "pathetic", "despair", "destroy", "darkness", "dark",
		"fear", "crush", "mercy", "worthless", "bow", "ruin", "hopeless",
		"suffer", "doom", "power", "rule", "conquer", "fall", "chaos", "beg",
		"tremble", "shadow", "hero", "heroes", "nothing",
	},
}

-- Saying a line while in a fight (boss fight, or an enemy player nearby)
-- multiplies its aura.
Config.FightLineMultiplier = 2
-- Ignore heroic messages sent closer together than this (anti-spam), seconds.
Config.LineGlobalCooldown = 2.5
-- Repeating the same line within this window costs aura instead ("cringe").
Config.LineRepeatWindow = 30
Config.LineRepeatPenalty = 15
-- How long the line floats over your head, seconds.
Config.SpeechDuration = 3.5

---------------------------------------------------------------------------
-- Style meter (0-100). Fighting cool fills it, getting hit drains it.
---------------------------------------------------------------------------
Config.Style = {
	Max = 100,
	PerHit = 5,
	PerPerfectDodge = 18,
	PerHeroicLineInFight = 10,
	LostWhenHit = 35,
	DecayDelay = 3, -- seconds without gaining style before it decays
	DecayPerSecond = 6,
	-- Letter ranks (lowest first): reached when Style >= Min.
	Ranks = {
		{ Name = "D", Min = 0, Multiplier = 1 },
		{ Name = "C", Min = 20, Multiplier = 1.2 },
		{ Name = "B", Min = 40, Multiplier = 1.4 },
		{ Name = "A", Min = 60, Multiplier = 1.7 },
		{ Name = "S", Min = 80, Multiplier = 2 },
		{ Name = "SSS", Min = 100, Multiplier = 3 },
	},
}

---------------------------------------------------------------------------
-- Player combat
---------------------------------------------------------------------------
Config.Combat = {
	-- Slash damage / range / speed, dash cooldown, health and move speed
	-- come from your class (see Classes.lua).
	AuraPerHit = 1, -- multiplied by your style rank multiplier, rounded

	DashSpeed = 95,
	DashDuration = 0.18, -- how long the client pushes you forward
	DashInvulnerability = 0.45, -- i-frames, seconds
	PerfectDodgeWindow = 0.6, -- dash this close before an impact = perfect dodge
	PerfectDodgeAura = 15,

	UltimateStyleCost = 80, -- needs S rank or higher; spends this much style
	UltimateCooldown = 3,

	DeathAuraLoss = 20, -- dying in a boss fight ("took the L")
}

---------------------------------------------------------------------------
-- PvP: Good vs Evil only. Players on the same side can't hurt each other,
-- and nobody can be hurt by players inside a spawn's safe zone.
---------------------------------------------------------------------------
Config.Pvp = {
	KillAura = 40, -- base aura for defeating an enemy player
	DeathAuraLoss = 10, -- for being defeated by one
	KillCreditWindow = 10, -- your hit must be this recent to get the kill
	-- Defeating the same player again within RepeatWindow seconds pays
	-- RepeatFalloff times less each time (stops kill farming).
	RepeatWindow = 120,
	RepeatFalloff = 0.5,
	GiantSlayerPerRank = 0.5, -- bonus per aura rank the victim is above you
	GiantSlayerMax = 1.5,
	RevengeBonus = 0.5, -- for defeating whoever last defeated you
	HitRangeBonus = 2, -- extra slash reach against players (hit boxes are small)
	HitConeDot = 0.2, -- players must be roughly in front of you to be slashed
	FightRadius = 40, -- an enemy player this close counts as "in a fight"
	SafeZoneRadius = 30,
	ClassChangeCooldown = 5,
	CombatLock = 8, -- can't change class this soon after a player hit you
	HitPlayerDamageFactor = 1, -- multiplies slash damage against players
}
Config.PvpBonuses = {
	GiantSlayer = "GIANT SLAYER (they outranked you)",
	Revenge = "REVENGE",
}

---------------------------------------------------------------------------
-- Boss defeat bonuses. Bonuses add together, then multiply the base reward:
--   reward = Reward * styleMultiplier * (1 + sum of bonuses)
---------------------------------------------------------------------------
Config.DefeatBonuses = {
	Flawless = { Label = "FLAWLESS (no damage taken)", Bonus = 1.0 },
	Clutch = { Label = "CLUTCH (final blow under 25% HP)", Bonus = 0.75 },
	CalledIt = { Label = "CALLED IT (heroic line right before the kill)", Bonus = 0.5 },
	Finisher = { Label = "FINISHER (killed with your ultimate)", Bonus = 0.5 },
}
Config.ClutchHealthFraction = 0.25
Config.CalledItWindow = 6 -- seconds between your line and the killing blow
-- Participants who didn't land the kill get this fraction of the base reward.
Config.AssistFraction = 0.6

-- After a kill, walk away from the explosion without looking back.
Config.WalkAway = {
	Label = "DIDN'T LOOK BACK",
	Aura = 50,
	Duration = 2.5, -- seconds you must keep walking away
	SampleInterval = 0.25,
	RequiredFraction = 0.8, -- of samples that must be "walking away"
}

---------------------------------------------------------------------------
-- Bosses. Attacks: "Slam" (circle around the boss), "Charge" (line toward
-- the target), "Barrage" (circles under every fighter).
---------------------------------------------------------------------------
Config.Bosses = {
	{
		Id = "Brute",
		Name = "Grand Brute",
		Title = "The Wall That Hits Back",
		MaxHealth = 700,
		Reward = 120,
		Size = 9,
		Speed = 10,
		Color = { 120, 85, 60 },
		EyeColor = { 255, 60, 30 },
		Attacks = { "Slam", "Charge" },
		AttackInterval = 3.2,
		Windup = 1.1,
		Damage = 25,
		Cooldown = 20, -- seconds before this altar can be used again
	},
	{
		Id = "Storm",
		Name = "Storm Tyrant",
		Title = "Lord of the Grey Sky",
		MaxHealth = 1800,
		Reward = 350,
		Size = 11,
		Speed = 13,
		Color = { 60, 70, 110 },
		EyeColor = { 120, 220, 255 },
		Attacks = { "Slam", "Charge", "Barrage" },
		AttackInterval = 2.7,
		Windup = 0.95,
		Damage = 30,
		Cooldown = 30,
	},
	{
		Id = "Rival",
		Name = "The Final Rival",
		Title = "The One Who Was Always Stronger",
		MaxHealth = 3600,
		Reward = 900,
		Size = 8,
		Speed = 17,
		Color = { 25, 25, 30 },
		EyeColor = { 200, 80, 255 },
		Attacks = { "Slam", "Charge", "Barrage" },
		AttackInterval = 2.3,
		Windup = 0.85,
		Damage = 35,
		Cooldown = 45,
		EnrageAt = 0.5, -- below this health fraction, attacks speed up
		EnrageSpeedup = 0.7, -- windup and interval multiply by this
	},
}

Config.Attacks = {
	Slam = { Radius = 16 },
	Charge = { Length = 60, Width = 10, Duration = 0.45 },
	Barrage = { Radius = 8 },
}

-- The boss gives up and leaves if nobody is fighting it for this long.
Config.BossLeashTime = 12
-- Fighters must be within this distance of the arena centre.
Config.ArenaRadius = 90

---------------------------------------------------------------------------
-- Saving
---------------------------------------------------------------------------
Config.DataStoreName = "AuraFarm_v1"
Config.AutosaveInterval = 120

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">HeroicLines</string>
          <string name="Source"><![CDATA[--[[
	Decides how much aura a chat message is worth.

	Pure Luau (no Roblox APIs) so it can be unit tested outside Roblox; all
	tuning comes in through the `config` argument (see Config.lua).
]]

local HeroicLines = {}

-- Lowercase, drop apostrophes ("you've" -> "youve"), turn everything that
-- isn't a letter or digit into a space, collapse runs of spaces.
function HeroicLines.normalize(text: string): string
	local s = string.lower(text)
	s = string.gsub(s, "\226\128\153", "") -- curly apostrophe (UTF-8 E2 80 99)
	s = string.gsub(s, "'", "")
	s = string.gsub(s, "[^%w]+", " ")
	s = string.gsub(s, "^%s+", "")
	s = string.gsub(s, "%s+$", "")
	return s
end

function HeroicLines.words(text: string): { string }
	local out = {}
	for word in string.gmatch(HeroicLines.normalize(text), "%S+") do
		table.insert(out, word)
	end
	return out
end

local function wordSet(words: { string }): { [string]: boolean }
	local set = {}
	for _, w in ipairs(words) do
		set[w] = true
	end
	return set
end

-- Fraction of the line's unique words that appear in the message (0..1).
function HeroicLines.similarity(messageWords: { string }, lineText: string): number
	local lineWords = HeroicLines.words(lineText)
	local unique = wordSet(lineWords)
	local messageSet = wordSet(messageWords)
	local total, found = 0, 0
	for w in pairs(unique) do
		total += 1
		if messageSet[w] then
			found += 1
		end
	end
	if total == 0 then
		return 0
	end
	return found / total
end

-- Best matching heroic line, or nil. A message far longer than the line
-- (e.g. every line pasted at once) never matches.
function HeroicLines.match(message: string, lines, threshold: number)
	local messageWords = HeroicLines.words(message)
	if #messageWords == 0 then
		return nil, 0
	end
	local best, bestScore, bestLength = nil, 0, 0
	for _, line in ipairs(lines) do
		local lineLength = #HeroicLines.words(line.Text)
		if #messageWords <= lineLength * 2 + 3 then
			local score = HeroicLines.similarity(messageWords, line.Text)
			if score >= threshold and (score > bestScore or (score == bestScore and lineLength > bestLength)) then
				best, bestScore, bestLength = line, score, lineLength
			end
		end
	end
	return best, bestScore
end

-- Aura for an unscripted message made of heroic words, and how many
-- different keywords it used.
function HeroicLines.freestyle(message: string, freestyleConfig): (number, number)
	local messageSet = wordSet(HeroicLines.words(message))
	local count = 0
	for _, keyword in ipairs(freestyleConfig.Keywords) do
		if messageSet[keyword] then
			count += 1
		end
	end
	if count < freestyleConfig.MinKeywords then
		return 0, count
	end
	return math.min(count * freestyleConfig.AuraPerKeyword, freestyleConfig.MaxAura), count
end

--[[
	context = {
		inFight: boolean,           -- boss fight, or an enemy player nearby
		healthFraction: number,     -- the speaker's health, 0..1
		foeHealthFraction: number?, -- lowest health fraction of the boss /
		                            -- nearby enemy players; nil if none
		sinceDodge: number,         -- seconds since the last perfect dodge
		sinceHit: number,           -- seconds since the speaker was last hit
		sinceKill: number,          -- seconds since the speaker defeated an enemy player
	}
]]
function HeroicLines.conditionMet(condition: string?, context): boolean
	if condition == nil then
		return false
	elseif condition == "FoeLow" then
		return context.foeHealthFraction ~= nil and context.foeHealthFraction < 0.25
	elseif condition == "LowHealth" then
		return context.healthFraction < 0.3
	elseif condition == "AfterDodge" then
		return context.sinceDodge <= 4
	elseif condition == "AfterHit" then
		return context.sinceHit <= 4
	elseif condition == "AfterKill" then
		return context.sinceKill <= 5
	elseif condition == "NoFight" then
		return not context.inFight
	end
	return false
end

HeroicLines.ConditionLabels = {
	FoeLow = "FOE ON ITS LAST LEGS",
	LowHealth = "LOW HP",
	AfterDodge = "AFTER A PERFECT DODGE",
	AfterHit = "SHRUGGED IT OFF",
	AfterKill = "RIGHT AFTER A TAKEDOWN",
	NoFight = "PRE-FIGHT",
}

-- The line list and freestyle words for a side ("Good", "Evil" or nil).
-- Undecided players use the heroic lines.
function HeroicLines.forSide(config, side: string?)
	if side == "Evil" then
		return config.VillainLines, config.VillainFreestyle
	end
	return config.HeroicLines, config.Freestyle
end

--[[
	Scores a message. Doesn't change any state: the caller records
	history[result.historyKey] = now when result.historyKey is set.

	history: { [string]: number } -- key -> last time it was said
	side: "Good" | "Evil" | nil   -- picks heroic or villain lines
	Returns {
		kind = "Line" | "Freestyle" | "Repeat" | "None",
		line = <line table>?, amount = number, tags = { string },
		historyKey = string?,
	}
]]
function HeroicLines.evaluate(message: string, context, config, history, now: number, side: string?)
	local lines, freestyleConfig = HeroicLines.forSide(config, side)
	local line = HeroicLines.match(message, lines, config.LineMatchThreshold)
	local tags = {}
	local amount
	local historyKey

	if line then
		historyKey = "line:" .. line.Id
		amount = line.Aura
		if line.Condition and HeroicLines.conditionMet(line.Condition, context) then
			amount *= line.Bonus
			table.insert(tags, string.format("%s x%s", HeroicLines.ConditionLabels[line.Condition], tostring(line.Bonus)))
		end
	else
		local freestyleAura = HeroicLines.freestyle(message, freestyleConfig)
		if freestyleAura <= 0 then
			return { kind = "None", amount = 0, tags = tags }
		end
		historyKey = "free:" .. HeroicLines.normalize(message)
		amount = freestyleAura
		table.insert(tags, "FREESTYLE")
	end

	local last = history[historyKey]
	if last and now - last < config.LineRepeatWindow then
		return {
			kind = "Repeat",
			line = line,
			amount = -config.LineRepeatPenalty,
			tags = { "CRINGE: YOU ALREADY SAID THAT" },
			historyKey = historyKey,
		}
	end

	if context.inFight then
		amount *= config.FightLineMultiplier
		table.insert(tags, string.format("IN A FIGHT x%s", tostring(config.FightLineMultiplier)))
	end

	return {
		kind = if line then "Line" else "Freestyle",
		line = line,
		amount = math.floor(amount + 0.5),
		tags = tags,
		historyKey = historyKey,
	}
end

return HeroicLines
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">AuraFarmServer</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">AuraService</string>
          <string name="Source"><![CDATA[-- Owns each player's aura (saved, with their class), style meter, combat
-- timers and the heroic / villain line handling.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local AuraMath = require(Shared:WaitForChild("AuraMath"))
local Classes = require(Shared:WaitForChild("Classes"))
local HeroicLines = require(Shared:WaitForChild("HeroicLines"))
local Effects = require(script.Parent.Effects)
local Remotes = require(script.Parent.Remotes)

local AuraService = {}

export type State = {
	aura: number,
	loaded: boolean,
	savedClassId: string?,
	style: number,
	lastStyleGain: number,
	lastDodge: number,
	lastHit: number,
	lastKill: number,
	lastHeroicLine: number,
	lastLineTime: number,
	lineHistory: { [string]: number },
	lastMessage: string,
	lastMessageTime: number,
	lastSlash: number,
	lastDash: number,
	dashStartPos: Vector3?,
	invulnerableUntil: number,
	lastUltimate: number,
	-- PvP bookkeeping (see PvpService)
	lastAttacker: Player?,
	lastAttackTime: number,
	lastAttackSource: string,
	lastAttackStyle: number, -- attacker's style when they last hit us
	dodgedDash: number, -- the dash a PvP perfect dodge was already given for
	lastKilledBy: Player?,
	kills: { [number]: { number } }, -- victim UserId -> times defeated
	lastClassChange: number,
	rankIndex: number,
	auraValue: IntValue,
	rankValue: StringValue,
}

local states: { [Player]: State } = {}

-- Supplies { inFight, foeHealthFraction } for a player. Main sets this from
-- BossService and PvpService (they can't be required from here without a
-- require cycle).
local contextProvider = function(_player: Player)
	return { inFight = false, foeHealthFraction = nil }
end

function AuraService.setContextProvider(fn)
	contextProvider = fn
end

---------------------------------------------------------------------------
-- Class helpers (the class lives in player attributes, set by ClassService)
---------------------------------------------------------------------------

function AuraService.sideOf(player: Player): string?
	local side = player:GetAttribute("Side")
	return if side == "Good" or side == "Evil" then side else nil
end

-- The player's class, or nil while they're undecided.
function AuraService.classOf(player: Player)
	return Classes.get(player:GetAttribute("ClassId"))
end

-- A class stat, falling back to the defaults for undecided players.
function AuraService.stat(player: Player, key: string): number
	local class = AuraService.classOf(player)
	if class then
		return class[key]
	end
	return Classes.Defaults[key]
end

---------------------------------------------------------------------------
-- Saving
---------------------------------------------------------------------------

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[AuraFarm] DataStore unavailable, aura won't be saved:", result)
	end
end

local function key(player: Player): string
	return "u_" .. player.UserId
end

-- Returns saved aura and class id.
local function load(player: Player): (number, string?)
	if not store then
		return 0, nil
	end
	local ok, result = pcall(function()
		return store:GetAsync(key(player))
	end)
	if not ok then
		warn("[AuraFarm] Couldn't load aura for", player.Name, result)
		return 0, nil
	end
	if type(result) == "table" then
		local aura = if type(result.Aura) == "number" then result.Aura else 0
		local classId = if Classes.get(result.ClassId) then result.ClassId else nil
		return aura, classId
	end
	return 0, nil
end

function AuraService.save(player: Player)
	local state = states[player]
	-- Never overwrite saved aura with a profile that failed to load.
	if not store or not state or not state.loaded then
		return
	end
	local classId = player:GetAttribute("ClassId") or state.savedClassId
	local ok, err = pcall(function()
		store:SetAsync(key(player), { Aura = state.aura, ClassId = classId })
	end)
	if not ok then
		warn("[AuraFarm] Couldn't save aura for", player.Name, err)
	end
end

---------------------------------------------------------------------------
-- State
---------------------------------------------------------------------------

function AuraService.get(player: Player): State?
	return states[player]
end

local function notify(player: Player, payload)
	Remotes.Notify:FireClient(player, payload)
end
AuraService.notify = notify

-- Tells every player (except `except`, if given) about something.
function AuraService.announce(text: string, except: Player?)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= except then
			notify(player, { Kind = "Announce", Text = text })
		end
	end
end

function AuraService.rankName(player: Player): string
	local state = states[player]
	local rank = Config.Ranks[state and state.rankIndex or 1]
	return AuraMath.rankName(rank, AuraService.sideOf(player))
end

-- Re-applies rank name, overhead tag and aura particles.
function AuraService.refreshVisuals(player: Player)
	local state = states[player]
	if not state then
		return
	end
	state.rankValue.Value = AuraService.rankName(player)
	local character = player.Character
	if not character then
		return
	end
	local rank = Config.Ranks[state.rankIndex]
	local color = Effects.color(rank.Color)
	local class = AuraService.classOf(player)
	local classLabel = if class then class.Name else "Undecided"
	local sideColor = if class then Effects.color(Classes.Sides[class.Side].Color) else Color3.fromRGB(200, 200, 200)
	Effects.updateOverhead(character, AuraService.rankName(player), color, state.aura, classLabel, sideColor)
	Effects.setAura(character, state.rankIndex, if class then Effects.color(class.Color) else color)
end

--[[
	Adds (or with a negative amount, removes) aura. Aura never drops below 0.
	title/tags describe why, for the client's popup. silent skips the popup
	(used for small per-hit aura and for big rewards, which get a banner).
]]
function AuraService.addAura(player: Player, amount: number, title: string?, tags: { string }?, silent: boolean?)
	local state = states[player]
	if not state or amount == 0 then
		return
	end
	state.aura = math.max(0, state.aura + amount)
	state.auraValue.Value = state.aura

	local rank, index = AuraMath.getRank(state.aura, Config.Ranks)
	if index ~= state.rankIndex then
		local rankedUp = index > state.rankIndex
		state.rankIndex = index
		if rankedUp then
			local name = AuraMath.rankName(rank, AuraService.sideOf(player))
			notify(player, { Kind = "RankUp", Rank = name, Color = rank.Color })
			AuraService.announce(string.format("%s is now a %s!", player.DisplayName, name), player)
		end
	end
	AuraService.refreshVisuals(player)

	if not silent then
		notify(player, { Kind = "Aura", Amount = amount, Title = title or "", Tags = tags or {} })
	end
end

---------------------------------------------------------------------------
-- Style meter
---------------------------------------------------------------------------

local function setStyle(player: Player, state: State, value: number)
	state.style = math.clamp(value, 0, Config.Style.Max)
	player:SetAttribute("Style", math.floor(state.style + 0.5))
end

-- Gains are multiplied by the class's StyleGain; losses aren't.
function AuraService.addStyle(player: Player, amount: number)
	local state = states[player]
	if not state then
		return
	end
	if amount > 0 then
		state.lastStyleGain = os.clock()
		amount *= AuraService.stat(player, "StyleGain")
	end
	setStyle(player, state, state.style + amount)
end

function AuraService.resetStyle(player: Player)
	local state = states[player]
	if state then
		setStyle(player, state, 0)
	end
end

function AuraService.styleRank(player: Player)
	local state = states[player]
	return AuraMath.getRank(state and state.style or 0, Config.Style.Ranks)
end

---------------------------------------------------------------------------
-- Damage and combat bookkeeping (called by Combat / BossService / PvpService)
---------------------------------------------------------------------------

-- Hurts a player, reduced by their class armor. Returns the damage dealt
-- (0 if they're invincible from a dash or Fortify).
function AuraService.takeDamage(player: Player, amount: number): number
	local state = states[player]
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not state or not humanoid or humanoid.Health <= 0 then
		return 0
	end
	if os.clock() < state.invulnerableUntil then
		return 0
	end
	local dealt = amount * (1 - AuraService.stat(player, "Armor"))
	humanoid:TakeDamage(dealt)
	state.lastHit = os.clock()
	AuraService.addStyle(player, -Config.Style.LostWhenHit)
	return dealt
end

function AuraService.heal(player: Player, amount: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 and amount > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
	end
end

-- Lifesteal for damage the player dealt.
function AuraService.onDealtDamage(player: Player, amount: number)
	local lifesteal = AuraService.stat(player, "Lifesteal")
	if lifesteal > 0 then
		AuraService.heal(player, amount * lifesteal)
	end
end

function AuraService.onPerfectDodge(player: Player)
	local state = states[player]
	if not state then
		return
	end
	state.lastDodge = os.clock()
	AuraService.addStyle(player, Config.Style.PerPerfectDodge)
	local styleRank = AuraService.styleRank(player)
	local amount = math.floor(Config.Combat.PerfectDodgeAura * styleRank.Multiplier + 0.5)
	AuraService.addAura(player, amount, "PERFECT DODGE", { "STYLE " .. styleRank.Name })
end

-- After a big win: walk away from `position` without looking back.
function AuraService.startWalkAwayCheck(player: Player, position: Vector3)
	local settings = Config.WalkAway
	local function rootOf(): BasePart?
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return nil
		end
		return character:FindFirstChild("HumanoidRootPart") :: BasePart?
	end
	local function flatDistance(at: Vector3): number
		return Vector3.new(at.X - position.X, 0, at.Z - position.Z).Magnitude
	end
	task.spawn(function()
		local startRoot = rootOf()
		if not startRoot then
			return
		end
		-- Uses positions rather than Humanoid.MoveDirection, which the API
		-- marks as not replicated.
		local lastDistance = flatDistance(startRoot.Position)
		local samples, good = 0, 0
		local elapsed = 0
		while elapsed < settings.Duration do
			task.wait(settings.SampleInterval)
			elapsed += settings.SampleInterval
			local root = rootOf()
			if not root then
				return
			end
			samples += 1
			local look = root.CFrame.LookVector
			local toTarget = position - root.Position
			local distance = flatDistance(root.Position)
			if AuraMath.isWalkingAway(look.X, look.Z, toTarget.X, toTarget.Z, distance - lastDistance) then
				good += 1
			end
			lastDistance = distance
		end
		if samples > 0 and good / samples >= settings.RequiredFraction then
			AuraService.addAura(player, settings.Aura, settings.Label, { "Cool people don't look at explosions" })
		end
	end)
end

---------------------------------------------------------------------------
-- Heroic / villain lines
---------------------------------------------------------------------------

function AuraService.handleMessage(player: Player, text: any)
	local state = states[player]
	if not state or type(text) ~= "string" or #text == 0 or #text > 200 then
		return
	end
	local now = os.clock()

	-- The same message can arrive twice (Player.Chatted and the client's
	-- chat hook); only score it once.
	local normalized = HeroicLines.normalize(text)
	if normalized == state.lastMessage and now - state.lastMessageTime < 2 then
		return
	end
	state.lastMessage, state.lastMessageTime = normalized, now

	if now - state.lastLineTime < Config.LineGlobalCooldown then
		return
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local fight = contextProvider(player)
	local context = {
		inFight = fight.inFight,
		foeHealthFraction = fight.foeHealthFraction,
		healthFraction = if humanoid and humanoid.MaxHealth > 0 then humanoid.Health / humanoid.MaxHealth else 1,
		sinceDodge = now - state.lastDodge,
		sinceHit = now - state.lastHit,
		sinceKill = now - state.lastKill,
	}

	local side = AuraService.sideOf(player)
	local result = HeroicLines.evaluate(text, context, Config, state.lineHistory, now, side)
	if result.kind == "None" then
		return
	end
	state.lastLineTime = now
	state.lineHistory[result.historyKey] = now

	if result.kind == "Repeat" then
		AuraService.addAura(player, result.amount, "AURA LOSS", result.tags)
		return
	end

	state.lastHeroicLine = now
	if context.inFight then
		AuraService.addStyle(player, Config.Style.PerHeroicLineInFight)
	end
	local title = if side == "Evil" then "Villainous freestyle" else "Freestyle heroics"
	if result.line then
		title = "\u{201C}" .. result.line.Text .. "\u{201D}"
		if character then
			local speechColor = if side == "Evil" then Color3.fromRGB(255, 110, 110) else Color3.fromRGB(255, 240, 160)
			Effects.showSpeech(character, result.line.Text, Config.SpeechDuration, speechColor)
		end
	end
	AuraService.addAura(player, result.amount, title, result.tags)
end

---------------------------------------------------------------------------
-- Player lifecycle
---------------------------------------------------------------------------

function AuraService.setupCharacter(player: Player, character: Model)
	character:WaitForChild("Head", 10)
	character:WaitForChild("HumanoidRootPart", 10)
	Effects.buildOverhead(character)
	local class = AuraService.classOf(player)
	Effects.buildSword(character, if class then Effects.color(class.Color) else nil)
	AuraService.refreshVisuals(player)
	local state = states[player]
	if state then
		setStyle(player, state, 0)
		state.invulnerableUntil = 0
		state.lastAttacker = nil
	end
end

-- Calls onLoaded(savedClassId) once the player's save has loaded (or failed).
function AuraService.setupPlayer(player: Player, onLoaded: (string?) -> ())
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local auraValue = Instance.new("IntValue")
	auraValue.Name = "Aura"
	auraValue.Parent = leaderstats
	local rankValue = Instance.new("StringValue")
	rankValue.Name = "Rank"
	rankValue.Value = Config.Ranks[1].Name
	rankValue.Parent = leaderstats
	leaderstats.Parent = player

	local never = -math.huge
	local state: State = {
		aura = 0,
		loaded = false,
		savedClassId = nil,
		style = 0,
		lastStyleGain = never,
		lastDodge = never,
		lastHit = never,
		lastKill = never,
		lastHeroicLine = never,
		lastLineTime = never,
		lineHistory = {},
		lastMessage = "",
		lastMessageTime = never,
		lastSlash = never,
		lastDash = never,
		dashStartPos = nil,
		invulnerableUntil = 0,
		lastUltimate = never,
		lastAttacker = nil,
		lastAttackTime = never,
		lastAttackSource = "",
		lastAttackStyle = 0,
		dodgedDash = never,
		lastKilledBy = nil,
		kills = {},
		lastClassChange = never,
		rankIndex = 1,
		auraValue = auraValue,
		rankValue = rankValue,
	}
	states[player] = state
	player:SetAttribute("Style", 0)

	-- Load in the background so the player's state exists right away.
	task.spawn(function()
		local saved, classId = load(player)
		if states[player] ~= state then
			return -- left while loading
		end
		state.loaded = true
		state.savedClassId = classId
		if saved > 0 then
			-- Silent: just restoring, not earning. Keep anything earned
			-- while the load was in flight.
			state.aura += saved
			auraValue.Value = state.aura
			local _, index = AuraMath.getRank(state.aura, Config.Ranks)
			state.rankIndex = index
			AuraService.refreshVisuals(player)
		end
		onLoaded(classId)
	end)
end

function AuraService.removePlayer(player: Player)
	AuraService.save(player)
	states[player] = nil
	-- Forget this player in everyone else's PvP bookkeeping.
	for _, state in pairs(states) do
		if state.lastAttacker == player then
			state.lastAttacker = nil
		end
		if state.lastKilledBy == player then
			state.lastKilledBy = nil
		end
	end
end

-- Style decay and autosave.
function AuraService.start()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.2 then
			return
		end
		local step = accumulator
		accumulator = 0
		local now = os.clock()
		for player, state in pairs(states) do
			if state.style > 0 then
				local decayed = AuraMath.decayStyle(state.style, now - state.lastStyleGain, step, Config.Style)
				if decayed ~= state.style then
					setStyle(player, state, decayed)
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(AuraService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending += 1
			task.spawn(function()
				AuraService.save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 20
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return AuraService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">BossService</string>
          <string name="Source"><![CDATA[-- Summons, moves and fights the bosses, and pays out aura when one dies.
-- One boss can be in the arena at a time.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local AuraMath = require(Shared:WaitForChild("AuraMath"))
local AuraService = require(script.Parent.AuraService)
local Effects = require(script.Parent.Effects)
local World = require(script.Parent.World)

local BossService = {}

type Participant = { damage: number, hurt: boolean }
type Boss = {
	def: any,
	model: Model,
	body: BasePart,
	eyes: { BasePart },
	radius: number,
	hoverY: number,
	health: number,
	maxHealth: number,
	alive: boolean,
	busy: boolean,
	enraged: boolean,
	target: Player?,
	lastEngaged: number,
	participants: { [Player]: Participant },
	baseColors: { [BasePart]: Color3 },
}

local active: Boss? = nil
local readyAt: { [string]: number } = {}

local bossFolder = Instance.new("Folder")
bossFolder.Name = "AuraFarmBosses"
bossFolder.Parent = workspace

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function inArena(position: Vector3): boolean
	return AuraMath.inCircle(position.X, position.Z, World.ArenaCenter.X, World.ArenaCenter.Z, Config.ArenaRadius)
end

-- Living players standing in the arena.
local function fighters(): { Player }
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local root = rootOf(player)
		if root and inArena(root.Position) then
			table.insert(list, player)
		end
	end
	return list
end

local function participant(boss: Boss, player: Player): Participant
	local entry = boss.participants[player]
	if not entry then
		entry = { damage = 0, hurt = false }
		boss.participants[player] = entry
	end
	return entry
end

local function bossPosition(boss: Boss): Vector3
	return boss.model:GetPivot().Position
end

local function groundUnder(position: Vector3): Vector3
	return Vector3.new(position.X, World.FloorY + 0.1, position.Z)
end

-- Distance from a point to the boss's surface (roughly).
function BossService.distanceTo(position: Vector3): number?
	local boss = active
	if not boss or not boss.alive then
		return nil
	end
	return (bossPosition(boss) - position).Magnitude - boss.radius
end

function BossService.getActive(): Boss?
	return active
end

-- For heroic lines: is this player in a boss fight, and how hurt is the boss?
function BossService.contextFor(player: Player)
	local boss = active
	local root = rootOf(player)
	if boss and boss.alive and root and inArena(root.Position) then
		return { inFight = true, foeHealthFraction = boss.health / boss.maxHealth }
	end
	return { inFight = false, foeHealthFraction = nil }
end

-- Did this player take part in the current boss fight?
function BossService.isParticipant(player: Player): boolean
	local boss = active
	return boss ~= nil and boss.alive and boss.participants[player] ~= nil
end

---------------------------------------------------------------------------
-- Model
---------------------------------------------------------------------------

local function buildModel(def): (Model, BasePart, { BasePart })
	local s = def.Size
	local color = Effects.color(def.Color)
	local eyeColor = Effects.color(def.EyeColor)
	local model = Instance.new("Model")
	model.Name = def.Name

	local function piece(name: string, size: Vector3, offset: CFrame, partColor: Color3, material: Enum.Material, shape: Enum.PartType?)
		local p = Instance.new("Part")
		p.Name = name
		if shape then
			p.Shape = shape
		end
		p.Size = size
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.Color = partColor
		p.Material = material
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CFrame = offset
		p.Parent = model
		return p
	end

	-- Built around the origin facing -Z, then moved into place with PivotTo.
	local body = piece("Body", Vector3.new(s, s * 1.1, s * 0.8), CFrame.new(), color, Enum.Material.Slate)
	piece("Head", Vector3.new(s * 0.55, s * 0.5, s * 0.55), CFrame.new(0, s * 0.8, -s * 0.05), color, Enum.Material.Slate)
	local eyes = {
		piece("EyeL", Vector3.new(s * 0.12, s * 0.07, 0.2), CFrame.new(-s * 0.13, s * 0.85, -s * 0.33), eyeColor, Enum.Material.Neon),
		piece("EyeR", Vector3.new(s * 0.12, s * 0.07, 0.2), CFrame.new(s * 0.13, s * 0.85, -s * 0.33), eyeColor, Enum.Material.Neon),
	}
	for side = -1, 1, 2 do
		piece("Shoulder", Vector3.new(s * 0.4, s * 0.4, s * 0.4), CFrame.new(side * s * 0.65, s * 0.4, 0) * CFrame.Angles(0, 0, math.rad(45)), color, Enum.Material.Slate)
		piece("Spike", Vector3.new(s * 0.12, s * 0.5, s * 0.12), CFrame.new(side * s * 0.75, s * 0.8, 0) * CFrame.Angles(0, 0, math.rad(-side * 25)), eyeColor, Enum.Material.Neon)
		piece("Fist", Vector3.new(s * 0.35, s * 0.35, s * 0.35), CFrame.new(side * s * 0.75, -s * 0.35, -s * 0.2), color, Enum.Material.Slate)
		piece("Horn", Vector3.new(s * 0.08, s * 0.35, s * 0.08), CFrame.new(side * s * 0.2, s * 1.15, -s * 0.05) * CFrame.Angles(0, 0, math.rad(-side * 20)), eyeColor, Enum.Material.Neon)
	end
	piece("Core", Vector3.new(s * 0.3, s * 0.3, s * 0.3), CFrame.new(0, 0, -s * 0.4), eyeColor, Enum.Material.Neon, Enum.PartType.Ball)

	model.PrimaryPart = body

	-- Overhead name + health bar.
	local gui = Instance.new("BillboardGui")
	gui.Name = "BossBar"
	gui.Size = UDim2.fromOffset(260, 46)
	gui.StudsOffset = Vector3.new(0, s * 1.5, 0)
	gui.MaxDistance = 250
	gui.LightInfluence = 0
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromOffset(260, 24)
	name.Font = Enum.Font.GothamBlack
	name.TextSize = 20
	name.TextColor3 = eyeColor
	name.TextStrokeTransparency = 0.2
	name.Text = def.Name
	name.Parent = gui
	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Position = UDim2.fromOffset(10, 28)
	back.Size = UDim2.fromOffset(240, 12)
	back.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
	back.BorderSizePixel = 0
	back.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(230, 50, 50)
	fill.BorderSizePixel = 0
	fill.Parent = back
	gui.Parent = body

	return model, body, eyes
end

local function updateHealthDisplay(boss: Boss)
	boss.model:SetAttribute("Health", math.max(0, math.floor(boss.health + 0.5)))
	local gui = boss.body:FindFirstChild("BossBar")
	local back = gui and gui:FindFirstChild("Back")
	local fill = back and back:FindFirstChild("Fill")
	if fill then
		fill.Size = UDim2.fromScale(math.clamp(boss.health / boss.maxHealth, 0, 1), 1)
	end
end

local function flash(boss: Boss)
	for part in pairs(boss.baseColors) do
		part.Color = Color3.new(1, 1, 1)
	end
	task.delay(0.07, function()
		for part, color in pairs(boss.baseColors) do
			if part.Parent then
				part.Color = color
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Attacks
---------------------------------------------------------------------------

local function windup(boss: Boss): number
	return boss.def.Windup * (if boss.enraged then boss.def.EnrageSpeedup else 1)
end

-- Damages everyone standing in the zone, or rewards them for a last-second
-- dash. inZone(x, z) -> boolean.
local function resolve(boss: Boss, inZone: (number, number) -> boolean)
	local now = os.clock()
	for _, player in ipairs(fighters()) do
		local root = rootOf(player)
		local state = AuraService.get(player)
		if root and state then
			local position = root.Position
			local hit = inZone(position.X, position.Z)
			local dashedRecently = now - state.lastDash <= Config.Combat.PerfectDodgeWindow
			local startedInZone = state.dashStartPos ~= nil and inZone(state.dashStartPos.X, state.dashStartPos.Z)
			local protected = now < state.invulnerableUntil

			if hit and not protected then
				if AuraService.takeDamage(player, boss.def.Damage) > 0 then
					participant(boss, player).hurt = true
				end
			elseif dashedRecently and (hit or startedInZone) then
				participant(boss, player)
				AuraService.onPerfectDodge(player)
			end
		end
	end
end

local function slam(boss: Boss)
	local radius = Config.Attacks.Slam.Radius + boss.radius
	local centre = groundUnder(bossPosition(boss))
	local t = windup(boss)
	Effects.telegraphCircle(centre, radius, t)
	-- Rise up during the windup, then drop.
	local start = boss.model:GetPivot()
	boss.model:PivotTo(start + Vector3.new(0, 4, 0))
	task.wait(t)
	if not boss.alive then
		return
	end
	boss.model:PivotTo(start - Vector3.new(0, 1.5, 0))
	Effects.shockwave(centre, radius, Effects.color(boss.def.EyeColor))
	resolve(boss, function(x, z)
		return AuraMath.inCircle(x, z, centre.X, centre.Z, radius)
	end)
	task.wait(0.25)
	if boss.alive then
		boss.model:PivotTo(start)
	end
end

local function charge(boss: Boss)
	local target = boss.target
	local targetRoot = target and rootOf(target)
	if not targetRoot then
		return
	end
	local from = bossPosition(boss)
	local flat = Vector3.new(targetRoot.Position.X - from.X, 0, targetRoot.Position.Z - from.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(0, 0, 1)
	end
	local direction = flat.Unit
	local length = Config.Attacks.Charge.Length
	local width = Config.Attacks.Charge.Width + boss.radius
	-- Don't charge out of the arena: shorten the run, or slam instead.
	local function staysInside(distance: number): boolean
		local finish = from + direction * distance
		return AuraMath.inCircle(finish.X, finish.Z, World.ArenaCenter.X, World.ArenaCenter.Z, Config.ArenaRadius - 8)
	end
	while length > 10 and not staysInside(length) do
		length -= 5
	end
	if length <= 10 then
		slam(boss)
		return
	end
	local origin = groundUnder(from)
	local t = windup(boss)
	Effects.telegraphRect(origin, direction, length, width, t)
	boss.model:PivotTo(CFrame.lookAt(from, from + direction))
	task.wait(t)
	if not boss.alive then
		return
	end

	resolve(boss, function(x, z)
		return AuraMath.inRect(x, z, origin.X, origin.Z, direction.X, direction.Z, length, width)
	end)
	-- Rush along the line.
	local duration = Config.Attacks.Charge.Duration
	local elapsed = 0
	while elapsed < duration and boss.alive do
		elapsed += RunService.Heartbeat:Wait()
		local alpha = math.min(elapsed / duration, 1)
		local position = from + direction * (length * alpha)
		boss.model:PivotTo(CFrame.lookAt(position, position + direction))
	end
end

local function barrage(boss: Boss)
	local radius = Config.Attacks.Barrage.Radius
	local spots = {}
	for _, player in ipairs(fighters()) do
		local root = rootOf(player)
		if root then
			table.insert(spots, groundUnder(root.Position))
		end
	end
	local t = windup(boss) * 1.2
	for _, spot in ipairs(spots) do
		Effects.telegraphCircle(spot, radius, t)
	end
	task.wait(t)
	if not boss.alive then
		return
	end
	local color = Effects.color(boss.def.EyeColor)
	for _, spot in ipairs(spots) do
		Effects.burst(spot + Vector3.new(0, 2, 0), radius, color, 0.35)
	end
	resolve(boss, function(x, z)
		for _, spot in ipairs(spots) do
			if AuraMath.inCircle(x, z, spot.X, spot.Z, radius) then
				return true
			end
		end
		return false
	end)
end

local ATTACKS = { Slam = slam, Charge = charge, Barrage = barrage }

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------

local function despawn(boss: Boss, reason: string)
	boss.alive = false
	if active == boss then
		active = nil
	end
	boss.model:Destroy()
	AuraService.announce(reason)
end

local function defeat(boss: Boss, killer: Player, source: string)
	boss.alive = false
	if active == boss then
		active = nil
	end
	local def = boss.def
	local now = os.clock()
	local explosion = bossPosition(boss)

	AuraService.announce(string.format("%s defeated %s!", killer.DisplayName, def.Name))

	for player, entry in pairs(boss.participants) do
		local state = AuraService.get(player)
		if state and player.Parent and entry.damage > 0 then
			local isKiller = player == killer
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			local healthFraction = if humanoid and humanoid.MaxHealth > 0 then humanoid.Health / humanoid.MaxHealth else 1
			local flags = {
				Killer = isKiller,
				Flawless = not entry.hurt,
				Clutch = isKiller and healthFraction > 0 and healthFraction < Config.ClutchHealthFraction,
				CalledIt = isKiller and now - state.lastHeroicLine <= Config.CalledItWindow,
				Finisher = isKiller and source == "Ultimate",
			}
			local styleRank = AuraService.styleRank(player)
			local total, breakdown = AuraMath.defeatReward(def.Reward, styleRank, flags, Config.DefeatBonuses, Config.AssistFraction)
			AuraService.addAura(player, total, nil, nil, true)
			AuraService.notify(player, {
				Kind = "Banner",
				Title = def.Name .. " DEFEATED",
				Lines = breakdown,
				Total = total,
				Color = def.EyeColor,
			})
			AuraService.startWalkAwayCheck(player, explosion)
		end
	end

	-- Out of the boss folder first so clients drop the health bar.
	boss.model.Parent = workspace
	Effects.explodeModel(boss.model, Effects.color(def.EyeColor))
end

-- Deal damage to the active boss. source is "Slash" or "Ultimate".
-- Returns true if the hit landed.
function BossService.damage(player: Player, amount: number, source: string): boolean
	local boss = active
	if not boss or not boss.alive then
		return false
	end
	local entry = participant(boss, player)
	entry.damage += amount
	boss.health -= amount
	boss.lastEngaged = os.clock()
	flash(boss)
	updateHealthDisplay(boss)

	local def = boss.def
	if def.EnrageAt and not boss.enraged and boss.health > 0 and boss.health / boss.maxHealth < def.EnrageAt then
		boss.enraged = true
		for _, eye in ipairs(boss.eyes) do
			eye.Color = Color3.fromRGB(255, 30, 30)
			boss.baseColors[eye] = eye.Color
		end
		boss.model:SetAttribute("Enraged", true)
		AuraService.announce(def.Name .. " is ENRAGED!")
	end

	if boss.health <= 0 then
		defeat(boss, player, source)
	end
	return true
end

-- Movement: drift toward the target and bob, unless mid-attack.
local function step(boss: Boss, dt: number)
	if boss.busy or not boss.alive then
		return
	end
	local current = bossPosition(boss)
	local bob = math.sin(os.clock() * 2) * 0.6
	local flatPos = Vector3.new(current.X, boss.hoverY + bob, current.Z)
	local facing = boss.model:GetPivot().LookVector
	local root = boss.target and rootOf(boss.target)
	if root then
		local toTarget = Vector3.new(root.Position.X - current.X, 0, root.Position.Z - current.Z)
		local distance = toTarget.Magnitude
		if distance > 0.1 then
			facing = toTarget.Unit
			local keepAway = boss.radius + 5
			if distance > keepAway then
				local speed = boss.def.Speed * (if boss.enraged then 1.3 else 1)
				flatPos += facing * math.min(speed * dt, distance - keepAway)
			end
		end
	end
	if not inArena(flatPos) then
		flatPos = Vector3.new(current.X, flatPos.Y, current.Z)
	end
	boss.model:PivotTo(CFrame.lookAt(flatPos, flatPos + Vector3.new(facing.X, 0, facing.Z)))
end

local function closestFighter(boss: Boss): Player?
	local best, bestDistance = nil, math.huge
	local position = bossPosition(boss)
	for _, player in ipairs(fighters()) do
		local root = rootOf(player)
		if root then
			local distance = (root.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = player, distance
			end
		end
	end
	return best
end

local function brain(boss: Boss)
	local def = boss.def
	local nextAttack = os.clock() + 2.5 -- a moment to say your opening line
	while boss.alive do
		local now = os.clock()
		boss.target = closestFighter(boss)
		if boss.target then
			boss.lastEngaged = now
		elseif now - boss.lastEngaged > Config.BossLeashTime then
			despawn(boss, def.Name .. " got bored and left.")
			return
		end

		if boss.target and now >= nextAttack then
			boss.busy = true
			local attack = ATTACKS[def.Attacks[math.random(1, #def.Attacks)]]
			local ok, err = pcall(attack, boss)
			if not ok then
				warn("[AuraFarm] Boss attack failed:", err)
			end
			boss.busy = false
			local interval = def.AttackInterval * (if boss.enraged then def.EnrageSpeedup else 1)
			nextAttack = os.clock() + interval
		end
		task.wait(0.1)
	end
end

function BossService.summon(player: Player, def)
	if active then
		AuraService.notify(player, { Kind = "Message", Text = active.def.Name .. " is already in the arena!" })
		return
	end
	local now = os.clock()
	if readyAt[def.Id] and now < readyAt[def.Id] then
		AuraService.notify(player, {
			Kind = "Message",
			Text = string.format("%s is recovering. Try again in %ds.", def.Name, math.ceil(readyAt[def.Id] - now)),
		})
		return
	end
	readyAt[def.Id] = now + def.Cooldown

	local model, body, eyes = buildModel(def)
	local hoverY = World.FloorY + def.Size * 0.55 + 1.5
	local spawnAt = Vector3.new(World.BossSpawn.X, hoverY, World.BossSpawn.Z)
	model:PivotTo(CFrame.lookAt(spawnAt, spawnAt + Vector3.new(0, 0, 1)))
	model:SetAttribute("DisplayName", def.Name)
	model:SetAttribute("Title", def.Title)
	model:SetAttribute("MaxHealth", def.MaxHealth)
	model:SetAttribute("Health", def.MaxHealth)
	model:SetAttribute("Enraged", false)
	model.Parent = bossFolder

	local baseColors = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			baseColors[descendant] = descendant.Color
		end
	end

	local boss: Boss = {
		def = def,
		model = model,
		body = body,
		eyes = eyes,
		radius = def.Size * 0.6,
		hoverY = hoverY,
		health = def.MaxHealth,
		maxHealth = def.MaxHealth,
		alive = true,
		busy = false,
		enraged = false,
		target = nil,
		lastEngaged = now,
		participants = {},
		baseColors = baseColors,
	}
	active = boss

	Effects.burst(spawnAt, 20, Effects.color(def.EyeColor), 0.7)
	Effects.shockwave(groundUnder(spawnAt), 30, Effects.color(def.EyeColor))
	AuraService.announce(string.format("%s challenged %s, %s!", player.DisplayName, def.Name, def.Title))

	task.spawn(brain, boss)
end

function BossService.start(altars)
	for _, def in ipairs(Config.Bosses) do
		local altar = altars[def.Id]
		altar.prompt.Triggered:Connect(function(player)
			BossService.summon(player, def)
		end)
	end

	RunService.Heartbeat:Connect(function(dt)
		local boss = active
		if boss then
			step(boss, dt)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local boss = active
		if boss then
			boss.participants[player] = nil
		end
	end)
end

return BossService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">ClassService</string>
          <string name="Source"><![CDATA[-- Sides and classes: Roblox Teams for Heroes / Villains / Undecided, class
-- selection, and applying a class's health and speed to the character.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))
local AuraService = require(script.Parent.AuraService)
local World = require(script.Parent.World)

local ClassService = {}

local teams: { [string]: Team } = {}

local function makeTeam(key: string, name: string, autoAssign: boolean)
	local team = Instance.new("Team")
	team.Name = name
	team.TeamColor = World.TeamColors[key]
	team.AutoAssignable = autoAssign
	team.Parent = Teams
	teams[key] = team
end

function ClassService.start()
	makeTeam("Undecided", "Undecided", true)
	makeTeam("Good", Classes.Sides.Good.Name, false)
	makeTeam("Evil", Classes.Sides.Evil.Name, false)
end

-- Respawns at the player's team spawn. (Player:LoadCharacter is
-- deprecated in favour of LoadCharacterAsync.)
local function respawn(player: Player)
	task.spawn(function()
		local ok, err = pcall(function()
			player:LoadCharacterAsync()
		end)
		if not ok and player.Parent then
			warn("[AuraFarm] Couldn't respawn", player.Name, err)
		end
	end)
end

-- Health and walk speed from the class (defaults while undecided).
function ClassService.applyCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.MaxHealth = AuraService.stat(player, "MaxHealth")
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = AuraService.stat(player, "WalkSpeed")
end

local function setClass(player: Player, class)
	player:SetAttribute("ClassId", class.Id)
	player:SetAttribute("Side", class.Side)
	player.Neutral = false
	player.Team = teams[class.Side]
	local state = AuraService.get(player)
	if state then
		state.savedClassId = class.Id
	end
	AuraService.refreshVisuals(player)
	respawn(player)
end

-- A player asked to become `classId` (from the class picker).
function ClassService.request(player: Player, classId: any)
	local class = Classes.get(classId)
	local state = AuraService.get(player)
	if not class or not state then
		return
	end
	if player:GetAttribute("ClassId") == class.Id then
		AuraService.notify(player, { Kind = "ClassChosen", ClassId = class.Id })
		return
	end
	local now = os.clock()
	if now - state.lastClassChange < Config.Pvp.ClassChangeCooldown then
		AuraService.notify(player, { Kind = "Message", Text = "Wait a moment before changing class again." })
		return
	end
	if state.lastAttacker and now - state.lastAttackTime < Config.Pvp.CombatLock then
		AuraService.notify(player, { Kind = "Message", Text = "You can't change class in the middle of a fight!" })
		return
	end
	state.lastClassChange = now

	local previousSide = AuraService.sideOf(player)
	setClass(player, class)
	AuraService.notify(player, { Kind = "ClassChosen", ClassId = class.Id })
	if previousSide ~= class.Side then
		local verb = if class.Side == "Evil" then "has turned to evil" else "has joined the heroes"
		AuraService.announce(string.format("%s %s as a %s!", player.DisplayName, verb, class.Name), player)
	end
end

function ClassService.setupPlayer(player: Player)
	player.Neutral = false
	player.Team = teams.Undecided
end

-- After the save loads: bring back the saved class, or ask them to pick.
function ClassService.onLoaded(player: Player, savedClassId: string?)
	if not player.Parent then
		return
	end
	local class = Classes.get(savedClassId)
	if class and player:GetAttribute("ClassId") == nil then
		setClass(player, class)
		AuraService.notify(player, { Kind = "ClassChosen", ClassId = class.Id })
	elseif not class then
		AuraService.notify(player, { Kind = "PickClass" })
	end
	-- The client waits for this before deciding whether to open the picker
	-- (the PickClass message can arrive before its scripts are listening).
	player:SetAttribute("Loaded", true)
end

return ClassService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[-- Validates the player's Slash / Dash / Ultimate requests using their
-- class's stats. Slashes and ultimates hit the boss and enemy players.
-- The client moves itself for dashes; the server owns cooldowns, i-frames
-- and damage.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local AuraMath = require(Shared:WaitForChild("AuraMath"))
local Classes = require(Shared:WaitForChild("Classes"))
local AuraService = require(script.Parent.AuraService)
local BossService = require(script.Parent.BossService)
local Effects = require(script.Parent.Effects)
local PvpService = require(script.Parent.PvpService)

local Combat = {}

local DEFAULT_COLOR = Color3.fromRGB(210, 235, 255)

local function aliveRoot(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function classColor(player: Player): Color3
	local class = AuraService.classOf(player)
	return if class then Effects.color(class.Color) else DEFAULT_COLOR
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Hits the boss for `amount`; returns true if it landed.
local function hitBoss(player: Player, amount: number, source: string): boolean
	if BossService.damage(player, amount, source) then
		AuraService.onDealtDamage(player, amount)
		return true
	end
	return false
end

---------------------------------------------------------------------------
-- Slash and dash
---------------------------------------------------------------------------

local function slash(player: Player, root: BasePart, state)
	local now = os.clock()
	if now - state.lastSlash < AuraService.stat(player, "SlashCooldown") then
		return
	end
	state.lastSlash = now
	Effects.slash(root.CFrame, classColor(player))

	local damage = AuraService.stat(player, "SlashDamage")
	local range = AuraService.stat(player, "SlashRange")
	local landed = false

	local distance = BossService.distanceTo(root.Position)
	if distance and distance <= range then
		landed = hitBoss(player, damage, "Slash") or landed
	end

	-- Enemy players roughly in front of you (or right on top of you).
	local look = flat(root.CFrame.LookVector).Unit
	for _, enemy in ipairs(PvpService.enemiesNear(player, root.Position, range + Config.Pvp.HitRangeBonus)) do
		local enemyRoot = aliveRoot(enemy)
		if enemyRoot then
			local offset = flat(enemyRoot.Position - root.Position)
			local inFront = offset.Magnitude < 3 or look:Dot(offset.Unit) >= Config.Pvp.HitConeDot
			if inFront and PvpService.damage(player, enemy, damage * Config.Pvp.HitPlayerDamageFactor, "Slash") > 0 then
				landed = true
			end
		end
	end

	if landed then
		AuraService.addStyle(player, Config.Style.PerHit)
		local styleRank = AuraService.styleRank(player)
		local aura = math.floor(Config.Combat.AuraPerHit * styleRank.Multiplier + 0.5)
		AuraService.addAura(player, aura, nil, nil, true)
	end
end

local function dash(player: Player, root: BasePart, state)
	local now = os.clock()
	-- A little slack for network jitter versus the client's own cooldown.
	if now - state.lastDash < AuraService.stat(player, "DashCooldown") - 0.15 then
		return
	end
	state.lastDash = now
	state.dashStartPos = root.Position
	state.invulnerableUntil = math.max(state.invulnerableUntil, now + Config.Combat.DashInvulnerability)
end

---------------------------------------------------------------------------
-- Ultimates. Each returns true if it was used (and should cost style).
---------------------------------------------------------------------------

local function nearestEnemy(player: Player, position: Vector3, radius: number): Player?
	local best, bestDistance = nil, math.huge
	for _, enemy in ipairs(PvpService.enemiesNear(player, position, radius)) do
		local enemyRoot = aliveRoot(enemy)
		if enemyRoot then
			local distance = (enemyRoot.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = enemy, distance
			end
		end
	end
	return best
end

-- Damage everything around `position` within `radius`. Returns damage dealt.
local function blast(player: Player, position: Vector3, radius: number, kind, power: number): number
	local total = 0
	local distance = BossService.distanceTo(position)
	if distance and distance <= radius and hitBoss(player, kind.BossDamage * power, "Ultimate") then
		total += kind.BossDamage * power
	end
	for _, enemy in ipairs(PvpService.enemiesNear(player, position, radius)) do
		total += PvpService.damage(player, enemy, kind.PlayerDamage * power, "Ultimate")
	end
	return total
end

-- Heal allies (and yourself) around you; aura for each ally helped.
local function supportAllies(player: Player, root: BasePart, kind, power: number, title: string, perAlly: (Player) -> ())
	local allies = PvpService.alliesNear(player, root.Position, kind.Radius)
	local helped = 0
	for _, ally in ipairs(allies) do
		local character = ally.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			AuraService.heal(ally, humanoid.MaxHealth * kind.HealPercent * power)
		end
		perAlly(ally)
		if ally ~= player then
			helped += 1
		end
	end
	if helped > 0 then
		AuraService.addAura(player, helped * kind.AuraPerAlly, title, { string.format("Helped %d all%s", helped, if helped == 1 then "y" else "ies") })
	end
end

local ULTIMATES = {}

function ULTIMATES.Pillar(player: Player, root: BasePart, kind, power: number, color: Color3): boolean
	local boss = BossService.getActive()
	local distance = BossService.distanceTo(root.Position)
	if boss and distance and distance <= kind.Range then
		local target = boss.model:GetPivot().Position
		Effects.pillar(Vector3.new(target.X, root.Position.Y - 3, target.Z), color)
		hitBoss(player, (boss.maxHealth * kind.BossFraction + kind.BossFlat) * power, "Ultimate")
		return true
	end
	local enemy = nearestEnemy(player, root.Position, kind.Range)
	local enemyRoot = enemy and aliveRoot(enemy)
	if enemy and enemyRoot then
		Effects.pillar(enemyRoot.Position - Vector3.new(0, 3, 0), color)
		PvpService.damage(player, enemy, kind.PlayerDamage * power, "Ultimate")
		return true
	end
	AuraService.notify(player, { Kind = "Message", Text = "No target in range for your ultimate!" })
	return false
end

function ULTIMATES.Nova(player: Player, root: BasePart, kind, power: number, color: Color3): boolean
	Effects.burst(root.Position, kind.Radius, color, 0.5)
	Effects.shockwave(root.Position - Vector3.new(0, 2.5, 0), kind.Radius, color)
	blast(player, root.Position, kind.Radius, kind, power)
	return true
end

function ULTIMATES.Drain(player: Player, root: BasePart, kind, power: number, color: Color3): boolean
	Effects.shockwave(root.Position - Vector3.new(0, 2.5, 0), kind.Radius, color)
	Effects.dome(root.Position, kind.Radius, color)
	local dealt = blast(player, root.Position, kind.Radius, kind, power)
	AuraService.heal(player, dealt * kind.HealFraction)
	return true
end

function ULTIMATES.Rush(player: Player, root: BasePart, kind, power: number, color: Color3): boolean
	local direction = flat(root.CFrame.LookVector)
	if direction.Magnitude < 0.1 then
		return false
	end
	direction = direction.Unit
	local origin = root.Position
	Effects.streak(origin, origin + direction * kind.Length, kind.Width, color)

	local boss = BossService.getActive()
	if boss and boss.alive then
		local position = boss.model:GetPivot().Position
		-- Widen the line by the boss's size so grazing it still counts.
		local width = kind.Width + boss.radius * 2
		if AuraMath.inRect(position.X, position.Z, origin.X, origin.Z, direction.X, direction.Z, kind.Length + boss.radius, width) then
			hitBoss(player, kind.BossDamage * power, "Ultimate")
		end
	end
	for _, enemy in ipairs(PvpService.enemiesNear(player, origin, kind.Length + 2)) do
		local enemyRoot = aliveRoot(enemy)
		if enemyRoot and AuraMath.inRect(enemyRoot.Position.X, enemyRoot.Position.Z, origin.X, origin.Z, direction.X, direction.Z, kind.Length, kind.Width) then
			PvpService.damage(player, enemy, kind.PlayerDamage * power, "Ultimate")
		end
	end
	-- Invincible during the rush, and the client carries you along the line.
	local state = AuraService.get(player)
	if state then
		state.invulnerableUntil = math.max(state.invulnerableUntil, os.clock() + 0.4)
	end
	AuraService.notify(player, { Kind = "Rush", Distance = kind.Length })
	return true
end

function ULTIMATES.Mend(player: Player, root: BasePart, kind, power: number, color: Color3): boolean
	Effects.dome(root.Position, kind.Radius, color)
	supportAllies(player, root, kind, power, "HEALER", function() end)
	return true
end

function ULTIMATES.Fortify(player: Player, root: BasePart, kind, power: number, color: Color3): boolean
	Effects.dome(root.Position, kind.Radius, color)
	local untilTime = os.clock() + kind.Duration * power
	supportAllies(player, root, kind, power, "PROTECTOR", function(ally)
		local allyState = AuraService.get(ally)
		if allyState then
			allyState.invulnerableUntil = math.max(allyState.invulnerableUntil, untilTime)
		end
	end)
	return true
end

local function ultimate(player: Player, root: BasePart, state)
	local now = os.clock()
	if now - state.lastUltimate < Config.Combat.UltimateCooldown then
		return
	end
	local class = AuraService.classOf(player)
	if not class then
		AuraService.notify(player, { Kind = "Message", Text = "Pick a class to unlock your ultimate!" })
		return
	end
	if state.style < Config.Combat.UltimateStyleCost then
		AuraService.notify(player, { Kind = "Message", Text = "Reach S style rank to unleash your ultimate!" })
		return
	end

	local ult = class.Ultimate
	local kind = Classes.UltimateKinds[ult.Kind]
	local color = Effects.color(class.Color):Lerp(Color3.new(1, 1, 1), 0.4)
	-- Damage first: a finishing ultimate is paid out at your full style rank.
	if ULTIMATES[ult.Kind](player, root, kind, ult.Power, color) then
		state.lastUltimate = now
		AuraService.addStyle(player, -Config.Combat.UltimateStyleCost)
		if player.Character then
			Effects.showSpeech(player.Character, string.upper(ult.Name) .. "!", 2, Effects.color(class.Color))
		end
	end
end

local HANDLERS = { Slash = slash, Dash = dash, Ultimate = ultimate }

function Combat.handle(player: Player, action: any)
	local handler = type(action) == "string" and HANDLERS[action]
	if not handler then
		return
	end
	local state = AuraService.get(player)
	local root = aliveRoot(player)
	if state and root then
		handler(player, root, state)
	end
end

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Effects</string>
          <string name="Source"><![CDATA[-- Visuals built from plain parts (no uploaded assets needed): attack
-- telegraphs, slashes, explosions, the hero blade, aura particles and the
-- overhead name tag.

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Effects = {}

local folder = Instance.new("Folder")
folder.Name = "AuraFarmEffects"
folder.Parent = workspace

function Effects.color(rgb: { number }): Color3
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	-- Shape first: changing it afterwards can reshape the part's Size.
	if props.Shape then
		p.Shape = props.Shape
	end
	for key, value in pairs(props) do
		if key ~= "Shape" and key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent or folder
	return p
end
Effects.part = part

local function fade(p: BasePart, duration: number, goal)
	goal = goal or {}
	goal.Transparency = 1
	TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
	Debris:AddItem(p, duration + 0.1)
end

-- A flat disc lying on the ground (cylinders point along X, so roll 90 degrees).
local function flatDiscCFrame(position: Vector3): CFrame
	return CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
end

---------------------------------------------------------------------------
-- Attack telegraphs: a red outline plus a fill that grows until impact.
---------------------------------------------------------------------------

function Effects.telegraphCircle(position: Vector3, radius: number, duration: number)
	local outline = part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, radius * 2, radius * 2),
		CFrame = flatDiscCFrame(position),
		Color = Color3.fromRGB(255, 40, 40),
		Transparency = 0.75,
	})
	local fill = part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.15, 0.5, 0.5),
		CFrame = flatDiscCFrame(position + Vector3.new(0, 0.02, 0)),
		Color = Color3.fromRGB(255, 90, 40),
		Transparency = 0.4,
	})
	TweenService:Create(fill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = Vector3.new(0.15, radius * 2, radius * 2),
	}):Play()
	Debris:AddItem(outline, duration)
	Debris:AddItem(fill, duration)
end

-- origin is on the ground, direction is a flat unit vector.
function Effects.telegraphRect(origin: Vector3, direction: Vector3, length: number, width: number, duration: number)
	local centre = origin + direction * (length / 2)
	local cframe = CFrame.lookAt(centre, centre + direction)
	local outline = part({
		Size = Vector3.new(width, 0.1, length),
		CFrame = cframe,
		Color = Color3.fromRGB(255, 40, 40),
		Transparency = 0.75,
	})
	local fill = part({
		Size = Vector3.new(width, 0.15, 0.5),
		CFrame = CFrame.lookAt(origin, origin + direction) * CFrame.new(0, 0.02, -0.25),
		Color = Color3.fromRGB(255, 90, 40),
		Transparency = 0.4,
	})
	TweenService:Create(fill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = Vector3.new(width, 0.15, length),
		CFrame = cframe * CFrame.new(0, 0.02, 0),
	}):Play()
	Debris:AddItem(outline, duration)
	Debris:AddItem(fill, duration)
end

---------------------------------------------------------------------------
-- Impacts
---------------------------------------------------------------------------

function Effects.shockwave(position: Vector3, radius: number, color: Color3)
	local ring = part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 2, 2),
		CFrame = flatDiscCFrame(position + Vector3.new(0, 0.1, 0)),
		Color = color,
		Transparency = 0.2,
	})
	fade(ring, 0.45, { Size = Vector3.new(0.3, radius * 2.2, radius * 2.2) })
end

function Effects.burst(position: Vector3, radius: number, color: Color3, duration: number?)
	local ball = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1,
		Position = position,
		Color = color,
		Transparency = 0.1,
	})
	fade(ball, duration or 0.4, { Size = Vector3.one * radius * 2 })
end

-- A crescent-ish neon streak in front of the attacker.
function Effects.slash(rootCFrame: CFrame, color: Color3)
	local roll = math.rad(math.random(-50, 50))
	local streak = part({
		Size = Vector3.new(9, 0.25, 1.4),
		CFrame = rootCFrame * CFrame.new(0, 0.5, -4.5) * CFrame.Angles(0, 0, roll),
		Color = color,
		Transparency = 0.15,
	})
	fade(streak, 0.18, { Size = Vector3.new(12, 0.1, 0.3) })
end

-- The ultimate: a column of light slamming down on the target.
function Effects.pillar(position: Vector3, color: Color3)
	local height = 120
	local column = part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, 14, 14),
		CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Transparency = 0.1,
	})
	fade(column, 0.8, { Size = Vector3.new(height, 1, 1) })
	Effects.burst(position, 22, Color3.new(1, 1, 1), 0.6)
	Effects.shockwave(position, 30, color)
end

-- A glowing dome around a point (Fortify / Mend).
function Effects.dome(position: Vector3, radius: number, color: Color3)
	local sphere = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * radius * 2,
		Position = position,
		Color = color,
		Transparency = 0.6,
		Material = Enum.Material.ForceField,
	})
	fade(sphere, 0.9, {})
end

-- A streak along a line (Rush).
function Effects.streak(from: Vector3, to: Vector3, width: number, color: Color3)
	local length = (to - from).Magnitude
	if length < 0.1 then
		return
	end
	local beam = part({
		Size = Vector3.new(width, 1, length),
		CFrame = CFrame.lookAt((from + to) / 2, to),
		Color = color,
		Transparency = 0.2,
	})
	fade(beam, 0.4, { Size = Vector3.new(0.2, 0.2, length) })
end

-- Unanchor every part of a model and throw them outwards.
function Effects.explodeModel(model: Model, color: Color3)
	local centre = model:GetPivot().Position
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = true
			local away = (descendant.Position - centre)
			if away.Magnitude < 0.1 then
				away = Vector3.new(0, 1, 0)
			end
			descendant.AssemblyLinearVelocity = away.Unit * math.random(40, 80) + Vector3.new(0, math.random(30, 60), 0)
		elseif descendant:IsA("BillboardGui") then
			descendant:Destroy()
		end
	end
	Effects.burst(centre, 30, color, 0.8)
	Effects.burst(centre, 18, Color3.new(1, 1, 1), 0.5)
	Effects.shockwave(Vector3.new(centre.X, centre.Y - 6, centre.Z), 45, color)
	Debris:AddItem(model, 4)
end

---------------------------------------------------------------------------
-- The hero blade, welded to the right hand (R15) or right arm (R6).
---------------------------------------------------------------------------

function Effects.buildSword(character: Model, bladeColor: Color3?)
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return
	end
	local old = character:FindFirstChild("HeroBlade")
	if old then
		old:Destroy()
	end

	local model = Instance.new("Model")
	model.Name = "HeroBlade"

	local function swordPart(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.CFrame = hand.CFrame * offset
		local weld = Instance.new("Weld")
		weld.Part0 = hand
		weld.Part1 = p
		weld.C0 = offset
		weld.Parent = p
		p.Parent = model
		return p
	end

	-- Grip sits at the bottom of the hand, blade points forward.
	local base = CFrame.new(0, -hand.Size.Y / 2, 0)
	swordPart("Grip", Vector3.new(0.3, 0.3, 1.1), base, Color3.fromRGB(40, 30, 30), Enum.Material.Fabric)
	swordPart("Guard", Vector3.new(1.3, 0.25, 0.25), base * CFrame.new(0, 0, -0.65), Color3.fromRGB(230, 190, 60), Enum.Material.Metal)
	swordPart("Blade", Vector3.new(0.35, 0.12, 4), base * CFrame.new(0, 0, -2.75), bladeColor or Color3.fromRGB(210, 235, 255), Enum.Material.Neon)

	model.Parent = character
end

---------------------------------------------------------------------------
-- Aura particles around the hero. Brighter and denser at higher ranks.
---------------------------------------------------------------------------

function Effects.setAura(character: Model, rankIndex: number, color: Color3)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local attachment = root:FindFirstChild("AuraAttachment")
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "AuraAttachment"
		attachment.Position = Vector3.new(0, -1.5, 0)
		attachment.Parent = root

		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Aura"
		emitter.LightEmission = 1
		emitter.Lifetime = NumberRange.new(0.6, 1.1)
		emitter.Speed = NumberRange.new(4, 7)
		emitter.SpreadAngle = Vector2.new(25, 25)
		emitter.Acceleration = Vector3.new(0, 6, 0)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.9),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Parent = attachment

		local light = Instance.new("PointLight")
		light.Name = "AuraLight"
		light.Range = 10
		light.Parent = attachment
	end

	local emitter = attachment:FindFirstChild("Aura") :: ParticleEmitter
	local light = attachment:FindFirstChild("AuraLight") :: PointLight
	emitter.Color = ColorSequence.new(color)
	-- NPCs (rank 1) get no visible aura; it grows from there.
	emitter.Rate = if rankIndex <= 1 then 0 else (rankIndex - 1) * 8
	light.Color = color
	light.Brightness = if rankIndex <= 1 then 0 else 0.4 * (rankIndex - 1)
end

---------------------------------------------------------------------------
-- Overhead tag: rank, aura, and the heroic line you just said.
---------------------------------------------------------------------------

local function label(parent: Instance, name: string, position: UDim2, size: UDim2, textSize: number)
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Position = position
	l.Size = size
	l.Font = Enum.Font.GothamBlack
	l.TextSize = textSize
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.3
	l.TextWrapped = true
	l.Text = ""
	l.Parent = parent
	return l
end

function Effects.buildOverhead(character: Model): BillboardGui?
	local head = character:FindFirstChild("Head")
	if not head then
		return nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "AuraTag"
	gui.Size = UDim2.fromOffset(320, 150)
	gui.StudsOffset = Vector3.new(0, 4.2, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	label(gui, "Speech", UDim2.fromOffset(0, 0), UDim2.fromOffset(320, 70), 20)
	label(gui, "Rank", UDim2.fromOffset(0, 72), UDim2.fromOffset(320, 30), 22)
	label(gui, "Aura", UDim2.fromOffset(0, 100), UDim2.fromOffset(320, 22), 15)
	label(gui, "Class", UDim2.fromOffset(0, 122), UDim2.fromOffset(320, 22), 15)
	gui.Parent = head
	return gui
end

function Effects.updateOverhead(character: Model, rankName: string, color: Color3, aura: number, className: string, sideColor: Color3)
	local head = character:FindFirstChild("Head")
	local gui = head and head:FindFirstChild("AuraTag")
	if not gui then
		return
	end
	local rank = gui:FindFirstChild("Rank") :: TextLabel
	rank.Text = rankName
	rank.TextColor3 = color
	local auraLabel = gui:FindFirstChild("Aura") :: TextLabel
	auraLabel.Text = string.format("%d aura", aura)
	local classLabel = gui:FindFirstChild("Class") :: TextLabel
	classLabel.Text = className
	classLabel.TextColor3 = sideColor
end

-- Only ever shows lines from Config (never raw player text), so nothing
-- unfiltered is displayed to other players.
function Effects.showSpeech(character: Model, text: string, duration: number, color: Color3)
	local head = character:FindFirstChild("Head")
	local gui = head and head:FindFirstChild("AuraTag")
	if not gui then
		return
	end
	local speech = gui:FindFirstChild("Speech") :: TextLabel
	speech.Text = "\u{201C}" .. text .. "\u{201D}"
	speech.TextColor3 = color
	local stamp = os.clock()
	speech:SetAttribute("Stamp", stamp)
	task.delay(duration, function()
		if speech.Parent and speech:GetAttribute("Stamp") == stamp then
			speech.Text = ""
		end
	end)
end

return Effects
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Aura Farm server entry point: builds the map and wires everything up.

local Players = game:GetService("Players")

local Remotes = require(script.Parent.Remotes)
local World = require(script.Parent.World)
local AuraService = require(script.Parent.AuraService)
local BossService = require(script.Parent.BossService)
local PvpService = require(script.Parent.PvpService)
local ClassService = require(script.Parent.ClassService)
local Combat = require(script.Parent.Combat)

local altars = World.build()
ClassService.start()

-- "In a fight" for heroic lines: a boss fight or an enemy player nearby.
AuraService.setContextProvider(function(player: Player)
	local boss = BossService.contextFor(player)
	local pvp = PvpService.contextFor(player)
	local foe = boss.foeHealthFraction
	if pvp.foeHealthFraction and (foe == nil or pvp.foeHealthFraction < foe) then
		foe = pvp.foeHealthFraction
	end
	return { inFight = boss.inFight or pvp.inFight, foeHealthFraction = foe }
end)
AuraService.start()
BossService.start(altars)

Remotes.Action.OnServerEvent:Connect(Combat.handle)
Remotes.Shout.OnServerEvent:Connect(AuraService.handleMessage)
Remotes.ChooseClass.OnServerEvent:Connect(ClassService.request)

local function onPlayerAdded(player: Player)
	ClassService.setupPlayer(player)
	AuraService.setupPlayer(player, function(savedClassId)
		ClassService.onLoaded(player, savedClassId)
	end)

	local function onCharacter(character: Model)
		task.spawn(AuraService.setupCharacter, player, character)
		task.spawn(ClassService.applyCharacter, player, character)
		task.spawn(PvpService.watchCharacter, player, character)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end

	-- Player.Chatted may not fire for every message under TextChatService,
	-- so the client also forwards what it sends (duplicates are ignored).
	player.Chatted:Connect(function(message)
		AuraService.handleMessage(player, message)
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerRemoving:Connect(AuraService.removePlayer)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">PvpService</string>
          <string name="Source"><![CDATA[-- Good vs Evil PvP: who can hurt whom, kill credit, kill rewards and the
-- aura lost for dying.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local AuraMath = require(Shared:WaitForChild("AuraMath"))
local Classes = require(Shared:WaitForChild("Classes"))
local AuraService = require(script.Parent.AuraService)
local BossService = require(script.Parent.BossService)
local World = require(script.Parent.World)

local PvpService = {}

local function aliveRoot(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function healthFraction(player: Player): number
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.MaxHealth <= 0 then
		return 0
	end
	return humanoid.Health / humanoid.MaxHealth
end

-- Only Good vs Evil, both alive, neither standing in a safe zone.
function PvpService.canHurt(attacker: Player, victim: Player): boolean
	if attacker == victim then
		return false
	end
	local attackerSide, victimSide = AuraService.sideOf(attacker), AuraService.sideOf(victim)
	if not attackerSide or not victimSide or attackerSide == victimSide then
		return false
	end
	local attackerRoot, victimRoot = aliveRoot(attacker), aliveRoot(victim)
	if not attackerRoot or not victimRoot then
		return false
	end
	return not World.inSafeZone(attackerRoot.Position) and not World.inSafeZone(victimRoot.Position)
end

-- Enemy players `player` can hurt within `radius` of `position`.
function PvpService.enemiesNear(player: Player, position: Vector3, radius: number): { Player }
	local list = {}
	for _, other in ipairs(Players:GetPlayers()) do
		local root = aliveRoot(other)
		if root and (root.Position - position).Magnitude <= radius and PvpService.canHurt(player, other) then
			table.insert(list, other)
		end
	end
	return list
end

-- Living players on `player`'s side (including `player`) within `radius`.
function PvpService.alliesNear(player: Player, position: Vector3, radius: number): { Player }
	local side = AuraService.sideOf(player)
	local list = {}
	for _, other in ipairs(Players:GetPlayers()) do
		local root = aliveRoot(other)
		if root and (root.Position - position).Magnitude <= radius and (other == player or (side ~= nil and AuraService.sideOf(other) == side)) then
			table.insert(list, other)
		end
	end
	return list
end

-- For heroic lines: an enemy player nearby counts as a fight.
function PvpService.contextFor(player: Player)
	local root = aliveRoot(player)
	if not root then
		return { inFight = false, foeHealthFraction = nil }
	end
	local lowest = nil
	for _, enemy in ipairs(PvpService.enemiesNear(player, root.Position, Config.Pvp.FightRadius)) do
		local fraction = healthFraction(enemy)
		if not lowest or fraction < lowest then
			lowest = fraction
		end
	end
	return { inFight = lowest ~= nil, foeHealthFraction = lowest }
end

--[[
	Damages an enemy player. Returns the damage dealt (0 if not allowed, or
	if the victim was invincible). A blocked hit right after the victim
	dashed counts as their perfect dodge (once per dash).
]]
function PvpService.damage(attacker: Player, victim: Player, amount: number, source: string): number
	if not PvpService.canHurt(attacker, victim) then
		return 0
	end
	local victimState = AuraService.get(victim)
	local attackerState = AuraService.get(attacker)
	if not victimState or not attackerState then
		return 0
	end

	-- Record the attacker before the damage: Humanoid.Died may fire during
	-- TakeDamage, and the kill must already be credited. Undone below if
	-- the hit is blocked.
	local now = os.clock()
	local previous = {
		victimState.lastAttacker,
		victimState.lastAttackTime,
		victimState.lastAttackSource,
		victimState.lastAttackStyle,
	}
	victimState.lastAttacker = attacker
	victimState.lastAttackTime = now
	victimState.lastAttackSource = source
	-- The attacker's style now: an ultimate spends style right after
	-- hitting, and a finishing blow should pay at the old rank.
	victimState.lastAttackStyle = attackerState.style

	local dealt = AuraService.takeDamage(victim, amount)
	if dealt > 0 then
		AuraService.onDealtDamage(attacker, dealt)
		return dealt
	end
	victimState.lastAttacker, victimState.lastAttackTime, victimState.lastAttackSource, victimState.lastAttackStyle =
		previous[1], previous[2], previous[3], previous[4]
	if now - victimState.lastDash <= Config.Combat.PerfectDodgeWindow and victimState.dodgedDash ~= victimState.lastDash then
		victimState.dodgedDash = victimState.lastDash
		AuraService.onPerfectDodge(victim)
	end
	return dealt
end

local function rewardKill(killer: Player, victim: Player, source: string, styleAtHit: number, position: Vector3)
	local killerState = AuraService.get(killer)
	local victimState = AuraService.get(victim)
	if not killerState or not victimState then
		return
	end
	local now = os.clock()

	-- How often the killer already beat this victim recently.
	local recent = {}
	for _, time in ipairs(killerState.kills[victim.UserId] or {}) do
		if now - time < Config.Pvp.RepeatWindow then
			table.insert(recent, time)
		end
	end
	local repeats = #recent
	table.insert(recent, now)
	killerState.kills[victim.UserId] = recent

	local killerHealth = healthFraction(killer)
	local flags = {
		Clutch = killerHealth > 0 and killerHealth < Config.ClutchHealthFraction,
		CalledIt = now - killerState.lastHeroicLine <= Config.CalledItWindow,
		Finisher = source == "Ultimate",
		Revenge = killerState.lastKilledBy == victim,
	}
	if flags.Revenge then
		killerState.lastKilledBy = nil
	end

	local styleRank = AuraMath.getRank(styleAtHit, Config.Style.Ranks)
	local total, breakdown = AuraMath.pvpKillReward(
		Config.Pvp,
		Config.PvpBonuses,
		Config.DefeatBonuses,
		killerState.rankIndex,
		victimState.rankIndex,
		styleRank,
		flags,
		repeats
	)
	killerState.lastKill = now
	AuraService.addAura(killer, total, nil, nil, true)
	local side = AuraService.sideOf(killer)
	AuraService.notify(killer, {
		Kind = "Banner",
		Title = "DEFEATED " .. string.upper(victim.DisplayName),
		Lines = breakdown,
		Total = total,
		Color = if side then Classes.Sides[side].Color else { 255, 255, 255 },
	})
	AuraService.announce(string.format("%s (%s) defeated %s (%s)!", killer.DisplayName, AuraService.rankName(killer), victim.DisplayName, AuraService.rankName(victim)))
	AuraService.startWalkAwayCheck(killer, position)
end

local function onDied(player: Player, position: Vector3)
	local state = AuraService.get(player)
	if not state then
		return
	end
	local killer = state.lastAttacker
	if killer and killer.Parent and os.clock() - state.lastAttackTime <= Config.Pvp.KillCreditWindow then
		rewardKill(killer, player, state.lastAttackSource, state.lastAttackStyle, position)
		state.lastKilledBy = killer
		AuraService.addAura(player, -Config.Pvp.DeathAuraLoss, "DEFEATED", { "by " .. killer.DisplayName })
	elseif BossService.isParticipant(player) then
		AuraService.addAura(player, -Config.Combat.DeathAuraLoss, "TOOK THE L", { "Fell in battle" })
	end
	state.lastAttacker = nil
	AuraService.resetStyle(player)
end

function PvpService.watchCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.Died:Connect(function()
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		onDied(player, if root then root.Position else Vector3.zero)
	end)
end

return PvpService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Creates the RemoteEvents the client and server talk through.
--   Action (client -> server): "Slash" | "Dash" | "Ultimate"
--   Shout  (client -> server): a chat message / heroic line to score
--   ChooseClass (client -> server): a class Id from Classes.lua
--   Notify (server -> client): a table with a Kind field (see Hud.lua)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = Instance.new("Folder")
folder.Name = "AuraFarmRemotes"

local function event(name: string): RemoteEvent
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	return remote
end

local Remotes = {
	Action = event("Action"),
	Shout = event("Shout"),
	ChooseClass = event("ChooseClass"),
	Notify = event("Notify"),
}

folder.Parent = ReplicatedStorage

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Builds the map from code so the place works straight out of `rojo build`:
-- sunset lighting, a grass field, a round stone arena ringed with pillars,
-- one summoning altar per boss and a spawn point with a how-to board.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local World = {}

World.FloorY = 1.2 -- top of the arena floor
World.ArenaCenter = Vector3.new(0, World.FloorY, 0)
World.BossSpawn = Vector3.new(0, World.FloorY, -25)

local map = Instance.new("Folder")
map.Name = "AuraFarmMap"

local function block(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	for key, value in pairs(props) do
		if key ~= "Shape" and key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent or map
	return p
end

local function setupLighting()
	Lighting.ClockTime = 17.6
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 120, 140)
	Lighting.Ambient = Color3.fromRGB(70, 60, 80)

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.32
	atmosphere.Color = Color3.fromRGB(255, 190, 150)
	atmosphere.Decay = Color3.fromRGB(120, 80, 140)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.8
	bloom.Size = 30
	bloom.Threshold = 0.9
	bloom.Parent = Lighting
end

local function buildArena()
	-- Ground (top at y = 1, above a template Baseplate's top at y = 0).
	block({
		Name = "Ground",
		Size = Vector3.new(700, 1, 700),
		Position = Vector3.new(0, 0.5, 0),
		Color = Color3.fromRGB(70, 120, 60),
		Material = Enum.Material.Grass,
	})

	-- Arena floor: a flat cylinder (cylinders point along X, so roll it).
	local radius = Config.ArenaRadius
	block({
		Name = "ArenaFloor",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, radius * 2, radius * 2),
		CFrame = CFrame.new(0, World.FloorY - 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(95, 90, 100),
		Material = Enum.Material.Slate,
	})
	block({
		Name = "ArenaSeal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.42, 30, 30),
		CFrame = CFrame.new(0, World.FloorY - 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 200, 90),
		Material = Enum.Material.Neon,
		Transparency = 0.6,
		CanCollide = false,
	})

	-- Pillars around the edge, leaving a gap on the spawn (+Z) side.
	local count = 14
	for i = 0, count - 1 do
		local angle = (i / count) * math.pi * 2
		local x, z = math.sin(angle) * (radius + 4), math.cos(angle) * (radius + 4)
		if z < radius * 0.8 then
			local height = 26 + (i % 3) * 6
			block({
				Name = "Pillar",
				Size = Vector3.new(6, height, 6),
				Position = Vector3.new(x, World.FloorY + height / 2, z),
				Color = Color3.fromRGB(80, 75, 90),
				Material = Enum.Material.Cobblestone,
			})
			block({
				Name = "PillarFlame",
				Size = Vector3.new(3, 3, 3),
				Position = Vector3.new(x, World.FloorY + height + 1.6, z),
				Color = Color3.fromRGB(255, 160, 60),
				Material = Enum.Material.Neon,
				CanCollide = false,
			})
		end
	end
end

local function billboard(adornee: BasePart, lines: { { text: string, size: number, color: Color3 } }, offset: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(300, #lines * 30)
	gui.StudsOffset = Vector3.new(0, offset, 0)
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	for i, line in ipairs(lines) do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromOffset(300, 30)
		l.Position = UDim2.fromOffset(0, (i - 1) * 30)
		l.Font = Enum.Font.GothamBlack
		l.TextSize = line.size
		l.TextColor3 = line.color
		l.TextStrokeTransparency = 0.3
		l.Text = line.text
		l.Parent = gui
	end
	gui.Parent = adornee
	return gui
end

-- Returns { [bossId] = { prompt = ProximityPrompt, crystal = Part } }
local function buildAltars()
	local altars = {}
	local spacing = 30
	for i, def in ipairs(Config.Bosses) do
		local x = (i - (#Config.Bosses + 1) / 2) * spacing
		local base = block({
			Name = def.Id .. "Altar",
			Size = Vector3.new(7, 3, 7),
			Position = Vector3.new(x, World.FloorY + 1.5, Config.ArenaRadius - 22),
			Color = Color3.fromRGB(60, 55, 70),
			Material = Enum.Material.Basalt,
		})
		local eye = def.EyeColor
		local crystal = block({
			Name = def.Id .. "Crystal",
			Size = Vector3.new(2.5, 5, 2.5),
			CFrame = CFrame.new(x, World.FloorY + 6, Config.ArenaRadius - 22) * CFrame.Angles(0, math.rad(45), math.rad(45)),
			Color = Color3.fromRGB(eye[1], eye[2], eye[3]),
			Material = Enum.Material.Neon,
			CanCollide = false,
		})

		billboard(base, {
			{ text = def.Name, size = 24, color = Color3.fromRGB(eye[1], eye[2], eye[3]) },
			{ text = def.Title, size = 15, color = Color3.fromRGB(230, 230, 230) },
			{ text = string.format("%d HP  -  %d base aura", def.MaxHealth, def.Reward), size = 14, color = Color3.fromRGB(255, 230, 120) },
		}, 9)

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Challenge"
		prompt.ObjectText = def.Name
		prompt.HoldDuration = 0.8
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = base

		altars[def.Id] = { prompt = prompt, crystal = crystal }
	end
	return altars
end

local HOW_TO = table.concat({
	"HOW TO FARM AURA",
	"",
	"1. Pick a side and a class: Heroes or Villains (CLASS button).",
	"2. Say heroic (or villainous) lines in chat or the SHOUT box.",
	"   The right line at the right moment is worth way more.",
	"   Repeating yourself is cringe.",
	"3. Challenge a boss at an altar, or fight the other side.",
	"   Click: slash    Q: dash    F: ultimate (at S style)",
	"4. Fight cool: last-second dodges, no damage taken,",
	"   call your shot, finish with your ultimate...",
	"   then walk away without looking back.",
	"",
	"Spawns are safe zones. Heroes can't hurt heroes,",
	"and villains can't hurt villains.",
}, "\n")

-- Team colors (BrickColor is what Teams and SpawnLocations use).
World.TeamColors = {
	Undecided = BrickColor.Gray(),
	Good = BrickColor.new("Bright yellow"),
	Evil = BrickColor.new("Really red"),
}

-- Where nobody can be hurt by other players: { position, radius }.
World.SafeZones = {}

local function spawnPad(name: string, position: Vector3, teamColor: BrickColor, color: Color3, facing: Vector3)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = name
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 1, 14)
	-- Players spawn facing the pad's front (-Z), so point it at `facing`.
	spawn.CFrame = CFrame.lookAt(position, Vector3.new(facing.X, position.Y, facing.Z))
	spawn.Color = color
	spawn.Material = Enum.Material.Neon
	spawn.Duration = 3
	spawn.Neutral = false
	spawn.TeamColor = teamColor
	spawn.AllowTeamChangeOnTouch = false
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = map

	local radius = Config.Pvp.SafeZoneRadius
	block({
		Name = name .. "SafeZone",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, radius * 2, radius * 2),
		CFrame = CFrame.new(position.X, 1.05, position.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.85,
		CanCollide = false,
		CanQuery = false,
	})
	table.insert(World.SafeZones, { position = position, radius = radius })
	return spawn
end

local function sign(position: Vector3, lines: { { text: string, size: number, color: Color3 } })
	local post = block({
		Name = "Sign",
		Size = Vector3.new(1, 10, 1),
		Position = position + Vector3.new(0, 5, 0),
		Color = Color3.fromRGB(50, 45, 55),
		Material = Enum.Material.Wood,
	})
	billboard(post, lines, 7)
end

local function buildBase(side: string, position: Vector3)
	local isGood = side == "Good"
	local color = if isGood then Color3.fromRGB(255, 205, 80) else Color3.fromRGB(200, 40, 60)
	local stone = if isGood then Color3.fromRGB(235, 230, 215) else Color3.fromRGB(40, 30, 40)
	spawnPad(if isGood then "HeroSpawn" else "VillainSpawn", position, World.TeamColors[side], color, World.ArenaCenter)

	-- A ring of columns (heroes) or spikes (villains) around the base.
	for i = 0, 7 do
		local angle = (i / 8) * math.pi * 2
		local at = position + Vector3.new(math.sin(angle) * 24, 0, math.cos(angle) * 24)
		if isGood then
			block({ Name = "Column", Size = Vector3.new(3, 16, 3), Position = at + Vector3.new(0, 8, 0), Color = stone, Material = Enum.Material.Marble })
			block({ Name = "ColumnLight", Size = Vector3.new(2, 2, 2), Position = at + Vector3.new(0, 17, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false })
		else
			block({
				Name = "Spike",
				Size = Vector3.new(3, 18, 3),
				CFrame = CFrame.new(at + Vector3.new(0, 8, 0)) * CFrame.Angles(math.rad(12), angle, 0),
				Color = stone,
				Material = Enum.Material.Basalt,
			})
			block({ Name = "SpikeGlow", Size = Vector3.new(1.5, 1.5, 1.5), Position = at + Vector3.new(0, 17.5, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false })
		end
	end

	sign(position + Vector3.new(0, 0, 18), {
		{ text = if isGood then "HALL OF HEROES" else "VILLAINS' LAIR", size = 26, color = color },
		{ text = "Safe zone: no PvP inside the glowing circle", size = 14, color = Color3.fromRGB(230, 230, 230) },
	})
end

local function buildSpawns()
	-- Lobby: where undecided players pick a class.
	local spawnPos = Vector3.new(0, 1.5, Config.ArenaRadius + 35)
	spawnPad("LobbySpawn", spawnPos, World.TeamColors.Undecided, Color3.fromRGB(200, 200, 210), World.ArenaCenter)

	buildBase("Good", Vector3.new(-(Config.ArenaRadius + 70), 1.5, 0))
	buildBase("Evil", Vector3.new(Config.ArenaRadius + 70, 1.5, 0))

	-- Front-left of the lobby spawn (players spawn facing the arena, -Z),
	-- with its Front face (-Z) turned to look at the spawn.
	local boardPos = spawnPos + Vector3.new(-22, 9.5, -12)
	local board = block({
		Name = "HowToBoard",
		Size = Vector3.new(30, 18, 1),
		CFrame = CFrame.lookAt(boardPos, Vector3.new(spawnPos.X, boardPos.Y, spawnPos.Z)),
		Color = Color3.fromRGB(35, 30, 45),
		Material = Enum.Material.SmoothPlastic,
	})
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 40
	surface.LightInfluence = 0
	surface.Parent = board
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.GothamBold
	text.TextSize = 30
	text.TextColor3 = Color3.fromRGB(255, 235, 190)
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextYAlignment = Enum.TextYAlignment.Top
	text.Text = HOW_TO
	text.Parent = surface
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 30)
	padding.PaddingTop = UDim.new(0, 24)
	padding.Parent = text
end

function World.inSafeZone(position: Vector3): boolean
	for _, zone in ipairs(World.SafeZones) do
		local dx, dz = position.X - zone.position.X, position.Z - zone.position.Z
		if dx * dx + dz * dz <= zone.radius * zone.radius then
			return true
		end
	end
	return false
end

function World.build()
	setupLighting()
	buildArena()
	buildSpawns()
	local altars = buildAltars()
	map.Parent = workspace
	return altars
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="17">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">AuraFarmClient</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">ClassPicker</string>
            <string name="Source"><![CDATA[-- The class picker: Heroes / Villains tabs, a grid of class cards, and a
-- details panel with stats, the ultimate and a CHOOSE button.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Classes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Classes"))

local ClassPicker = {}

local DARK = Color3.fromRGB(20, 16, 28)
local WHITE = Color3.new(1, 1, 1)

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function new(className: string, props, children: { Instance }?)
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

local function corner(radius: number)
	return new("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = WHITE,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}
	for key, value in pairs(props) do
		defaults[key] = value
	end
	return new("TextLabel", defaults)
end

local function percent(x: number): string
	return string.format("%d%%", math.floor(x * 100 + 0.5))
end

-- One line of stats for the details panel.
local function statLine(class): string
	local parts = {
		string.format("HP %d", class.MaxHealth),
		string.format("Speed %d", class.WalkSpeed),
		string.format("Damage %d", class.SlashDamage),
		string.format("Reach %d", class.SlashRange),
		string.format("Attack every %.2fs", class.SlashCooldown),
		string.format("Dash every %.1fs", class.DashCooldown),
	}
	if class.Armor > 0 then
		table.insert(parts, "Armor " .. percent(class.Armor))
	end
	if class.Lifesteal > 0 then
		table.insert(parts, "Lifesteal " .. percent(class.Lifesteal))
	end
	if class.StyleGain > 1 then
		table.insert(parts, "Style +" .. percent(class.StyleGain - 1))
	end
	return table.concat(parts, "   ")
end

function ClassPicker.new(playerGui: PlayerGui, onChoose: (string) -> ())
	local self = {}

	local screen = new("ScreenGui", {
		Name = "AuraFarmClassPicker",
		ResetOnSpawn = false,
		DisplayOrder = 10,
		Enabled = false,
		Parent = playerGui,
	})
	local panel = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.94, 0.9),
		BackgroundColor3 = DARK,
		BackgroundTransparency = 0.05,
		Parent = screen,
	}, {
		corner(14),
		new("UISizeConstraint", { MaxSize = Vector2.new(960, 640) }),
		new("UIStroke", { Color = Color3.fromRGB(255, 215, 110), Thickness = 2 }),
	})

	label({
		Position = UDim2.fromOffset(20, 10),
		Size = UDim2.new(1, -80, 0, 36),
		Font = Enum.Font.GothamBlack,
		TextSize = 28,
		Text = "CHOOSE YOUR PATH",
		Parent = panel,
	})
	local closeButton = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(36, 36),
		BackgroundColor3 = Color3.fromRGB(60, 50, 70),
		Font = Enum.Font.GothamBlack,
		TextSize = 18,
		TextColor3 = WHITE,
		Text = "X",
		Parent = panel,
	}, { corner(8) })

	-- Side tabs
	local tabs = {}
	local function tab(side: string, x: number)
		local info = Classes.Sides[side]
		tabs[side] = new("TextButton", {
			Position = UDim2.new(x, if x == 0 then 20 else 6, 0, 54),
			Size = UDim2.new(0.5, -26, 0, 40),
			BackgroundColor3 = rgb(info.Color),
			Font = Enum.Font.GothamBlack,
			TextSize = 18,
			TextColor3 = DARK,
			Text = string.format("%s  (%d)", string.upper(info.Name), #Classes[side]),
			Parent = panel,
		}, { corner(8) })
	end
	tab("Good", 0)
	tab("Evil", 0.5)

	-- Class grid
	local grid = new("ScrollingFrame", {
		Position = UDim2.fromOffset(20, 104),
		Size = UDim2.new(1, -40, 1, -260),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	}, {
		new("UIGridLayout", {
			CellSize = UDim2.fromOffset(198, 70),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	-- Details panel
	local details = new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -14),
		Size = UDim2.new(1, -40, 0, 136),
		BackgroundColor3 = Color3.fromRGB(38, 32, 50),
		Parent = panel,
	}, { corner(10) })
	local nameLabel = label({ Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -200, 0, 28), Font = Enum.Font.GothamBlack, TextSize = 24, Text = "Pick a class", Parent = details })
	local descLabel = label({ Position = UDim2.fromOffset(14, 38), Size = UDim2.new(1, -200, 0, 34), TextSize = 14, TextColor3 = Color3.fromRGB(220, 220, 220), Text = "", Parent = details })
	local statsLabel = label({ Position = UDim2.fromOffset(14, 74), Size = UDim2.new(1, -200, 0, 18), TextSize = 12, TextColor3 = Color3.fromRGB(150, 220, 255), Text = "", Parent = details })
	local ultLabel = label({ Position = UDim2.fromOffset(14, 96), Size = UDim2.new(1, -200, 0, 34), TextSize = 13, TextColor3 = Color3.fromRGB(255, 200, 120), Text = "", Parent = details })
	local chooseButton = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(170, 56),
		BackgroundColor3 = Color3.fromRGB(255, 215, 110),
		Font = Enum.Font.GothamBlack,
		TextSize = 20,
		TextColor3 = DARK,
		Text = "CHOOSE",
		Visible = false,
		Parent = details,
	}, { corner(10) })

	local selected = nil
	local currentClassId: string? = nil
	local canClose = false
	local cards: { [string]: TextButton } = {}

	local function selectClass(class)
		selected = class
		for id, card in pairs(cards) do
			local stroke = card:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Thickness = if id == class.Id then 3 else 0
			end
		end
		nameLabel.Text = string.format("%s  -  %s", class.Name, class.Role)
		nameLabel.TextColor3 = rgb(class.Color)
		descLabel.Text = class.Description
		statsLabel.Text = statLine(class)
		local kind = Classes.UltimateKinds[class.Ultimate.Kind]
		ultLabel.Text = string.format("Ultimate: %s (%s). %s.", class.Ultimate.Name, class.Ultimate.Kind, kind.Description)
		chooseButton.Visible = true
		chooseButton.Text = if class.Id == currentClassId then "CURRENT" else "CHOOSE"
	end

	local function showSide(side: string)
		for _, card in pairs(cards) do
			card:Destroy()
		end
		table.clear(cards)
		for name, button in pairs(tabs) do
			button.BackgroundTransparency = if name == side then 0 else 0.6
		end
		for i, class in ipairs(Classes[side]) do
			local card = new("TextButton", {
				BackgroundColor3 = Color3.fromRGB(45, 38, 58),
				AutoButtonColor = true,
				Text = "",
				LayoutOrder = i,
				Parent = grid,
			}, {
				corner(8),
				new("UIStroke", { Color = rgb(class.Color), Thickness = 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
				new("Frame", { Size = UDim2.new(0, 6, 1, 0), BackgroundColor3 = rgb(class.Color), BorderSizePixel = 0 }),
			})
			label({ Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -20, 0, 20), Font = Enum.Font.GothamBlack, TextSize = 15, Text = class.Name, Parent = card })
			label({ Position = UDim2.fromOffset(14, 26), Size = UDim2.new(1, -20, 0, 16), TextSize = 12, TextColor3 = Color3.fromRGB(190, 190, 200), Text = string.format("%s  -  HP %d", class.Role, class.MaxHealth), Parent = card })
			label({ Position = UDim2.fromOffset(14, 44), Size = UDim2.new(1, -20, 0, 16), TextSize = 12, TextColor3 = Color3.fromRGB(255, 200, 120), Text = class.Ultimate.Name, Parent = card })
			card.Activated:Connect(function()
				selectClass(class)
			end)
			cards[class.Id] = card
		end
		grid.CanvasPosition = Vector2.zero
	end

	tabs.Good.Activated:Connect(function()
		showSide("Good")
	end)
	tabs.Evil.Activated:Connect(function()
		showSide("Evil")
	end)
	chooseButton.Activated:Connect(function()
		if selected and selected.Id ~= currentClassId then
			onChoose(selected.Id)
		end
	end)
	closeButton.Activated:Connect(function()
		if canClose then
			screen.Enabled = false
		end
	end)

	-- Opens on the player's current class (or the hero tab).
	function self.open(classId: string?)
		currentClassId = classId
		canClose = classId ~= nil
		closeButton.Visible = canClose
		local class = Classes.get(classId)
		showSide(if class then class.Side else "Good")
		if class then
			selectClass(class)
		else
			selected = nil
			nameLabel.Text = "Pick a class"
			nameLabel.TextColor3 = WHITE
			descLabel.Text = "Heroes fight villains and villains fight heroes. Your own side can't hurt you."
			statsLabel.Text = ""
			ultLabel.Text = ""
			chooseButton.Visible = false
		end
		screen.Enabled = true
	end

	function self.close()
		screen.Enabled = false
	end

	function self.isOpen(): boolean
		return screen.Enabled
	end

	return self
end

return ClassPicker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- The on-screen UI, built in code: aura + rank panel, style meter, boss
-- health bar, aura popups, defeat banner, shout box with a line list, and
-- touch-friendly action buttons.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local AuraMath = require(Shared:WaitForChild("AuraMath"))
local HeroicLines = require(Shared:WaitForChild("HeroicLines"))

local Hud = {}

local GOLD = Color3.fromRGB(255, 215, 110)
local DARK = Color3.fromRGB(20, 16, 28)
local WHITE = Color3.new(1, 1, 1)

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function new(className: string, props, children: { Instance }?)
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

local function corner(radius: number)
	return new("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function stroke(color: Color3, thickness: number)
	return new("UIStroke", { Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function text(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextColor3 = WHITE,
		TextStrokeTransparency = 0.4,
		TextSize = 18,
	}
	for key, value in pairs(props) do
		defaults[key] = value
	end
	return new("TextLabel", defaults)
end

local function fadeOut(root: GuiObject, delay: number, duration: number)
	task.delay(delay, function()
		if not root.Parent then
			return
		end
		local info = TweenInfo.new(duration)
		for _, item in ipairs(root:GetDescendants()) do
			if item:IsA("TextLabel") then
				TweenService:Create(item, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			end
		end
		if root:IsA("TextLabel") then
			TweenService:Create(root, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
		if root.BackgroundTransparency < 1 then
			TweenService:Create(root, info, { BackgroundTransparency = 1 }):Play()
		end
		task.wait(duration)
		root:Destroy()
	end)
end

function Hud.new(
	playerGui: PlayerGui,
	callbacks: { onShout: (string) -> (), onAction: (string) -> (), onClassButton: () -> () }
)
	local self = {}
	local side: string? = nil -- "Good" / "Evil" / nil (undecided)
	local currentAura = 0
	local currentStyle = 0
	local ultimateName = ""

	local screen = new("ScreenGui", {
		Name = "AuraFarmHud",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})

	-------------------------------------------------------------------------
	-- Aura panel + style meter (bottom centre)
	-------------------------------------------------------------------------
	local panel = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(300, 118),
		BackgroundColor3 = DARK,
		BackgroundTransparency = 0.25,
		Parent = screen,
	}, { corner(10), stroke(GOLD, 1.5) })

	local styleLetter = text({
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.fromOffset(60, 44),
		TextSize = 40,
		Text = "D",
		TextColor3 = Color3.fromRGB(160, 160, 160),
		Parent = panel,
	})
	text({
		Position = UDim2.fromOffset(72, 6),
		Size = UDim2.fromOffset(150, 16),
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "STYLE",
		Parent = panel,
	})
	local styleBack = new("Frame", {
		Position = UDim2.fromOffset(72, 24),
		Size = UDim2.fromOffset(216, 10),
		BackgroundColor3 = Color3.fromRGB(50, 45, 60),
		BorderSizePixel = 0,
		Parent = panel,
	}, { corner(5) })
	local styleFill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
		Parent = styleBack,
	}, { corner(5) })
	local ultReady = text({
		Position = UDim2.fromOffset(72, 36),
		Size = UDim2.fromOffset(216, 14),
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 120, 120),
		Text = "",
		Parent = panel,
	})

	local auraLabel = text({
		Position = UDim2.fromOffset(10, 52),
		Size = UDim2.fromOffset(280, 28),
		TextSize = 26,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "0 AURA",
		Parent = panel,
	})
	local rankLabel = text({
		Position = UDim2.fromOffset(10, 80),
		Size = UDim2.fromOffset(280, 18),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = Config.Ranks[1].Name,
		Parent = panel,
	})
	local rankBack = new("Frame", {
		Position = UDim2.fromOffset(10, 102),
		Size = UDim2.fromOffset(280, 6),
		BackgroundColor3 = Color3.fromRGB(50, 45, 60),
		BorderSizePixel = 0,
		Parent = panel,
	}, { corner(3) })
	local rankFill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = rankBack,
	}, { corner(3) })

	function self.setAura(aura: number)
		currentAura = aura
		local rank, _, nextRank = AuraMath.getRank(aura, Config.Ranks)
		local name = AuraMath.rankName(rank, side)
		auraLabel.Text = string.format("%d AURA", aura)
		rankLabel.Text = if nextRank
			then string.format("%s   (next: %s at %d)", name, AuraMath.rankName(nextRank, side), nextRank.Min)
			else name .. "   (max rank)"
		rankLabel.TextColor3 = rgb(rank.Color)
		rankFill.BackgroundColor3 = rgb(rank.Color)
		rankFill.Size = UDim2.fromScale(AuraMath.rankProgress(aura, Config.Ranks), 1)
	end

	local STYLE_COLORS = {
		D = Color3.fromRGB(160, 160, 160),
		C = Color3.fromRGB(120, 200, 255),
		B = Color3.fromRGB(90, 255, 160),
		A = Color3.fromRGB(255, 230, 80),
		S = Color3.fromRGB(255, 120, 40),
		SSS = Color3.fromRGB(255, 60, 200),
	}

	function self.setStyle(style: number)
		currentStyle = style
		local rank = AuraMath.getRank(style, Config.Style.Ranks)
		styleLetter.Text = rank.Name
		styleLetter.TextColor3 = STYLE_COLORS[rank.Name] or WHITE
		styleFill.Size = UDim2.fromScale(style / Config.Style.Max, 1)
		styleFill.BackgroundColor3 = STYLE_COLORS[rank.Name] or GOLD
		ultReady.Text = if style >= Config.Combat.UltimateStyleCost and ultimateName ~= ""
			then string.format("[F] %s READY", string.upper(ultimateName))
			else ""
	end

	-------------------------------------------------------------------------
	-- Boss bar (top centre)
	-------------------------------------------------------------------------
	local bossFrame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(460, 62),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screen,
	})
	local bossName = text({ Size = UDim2.new(1, 0, 0, 24), TextSize = 22, Text = "", Parent = bossFrame })
	local bossTitle = text({
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, 0, 0, 16),
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.fromRGB(220, 220, 220),
		Text = "",
		Parent = bossFrame,
	})
	local bossBack = new("Frame", {
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundColor3 = Color3.fromRGB(40, 20, 20),
		BorderSizePixel = 0,
		Parent = bossFrame,
	}, { corner(4), stroke(Color3.fromRGB(0, 0, 0), 1.5) })
	local bossFill = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(220, 45, 45),
		BorderSizePixel = 0,
		Parent = bossBack,
	}, { corner(4) })
	local bossHp = text({
		Size = UDim2.fromScale(1, 1),
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		Text = "",
		ZIndex = 2,
		Parent = bossBack,
	})

	local bossConnections: { RBXScriptConnection } = {}
	function self.setBoss(model: Model?)
		for _, connection in ipairs(bossConnections) do
			connection:Disconnect()
		end
		table.clear(bossConnections)
		bossFrame.Visible = model ~= nil
		if not model then
			return
		end
		local function refresh()
			local health = model:GetAttribute("Health") or 0
			local maxHealth = model:GetAttribute("MaxHealth") or 1
			bossName.Text = model:GetAttribute("DisplayName") or model.Name
			bossTitle.Text = model:GetAttribute("Title") or ""
			bossFill.Size = UDim2.fromScale(math.clamp(health / maxHealth, 0, 1), 1)
			bossFill.BackgroundColor3 = if model:GetAttribute("Enraged")
				then Color3.fromRGB(200, 40, 255)
				else Color3.fromRGB(220, 45, 45)
			bossHp.Text = string.format("%d / %d", health, maxHealth)
		end
		table.insert(bossConnections, model.AttributeChanged:Connect(refresh))
		refresh()
	end

	-------------------------------------------------------------------------
	-- Aura popups (right side)
	-------------------------------------------------------------------------
	local feed = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.42, 0),
		Size = UDim2.fromOffset(340, 320),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		new("UIListLayout", {
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
		}),
	})
	local popupCount = 0

	function self.popup(payload)
		popupCount += 1
		local positive = payload.Amount >= 0
		local entry = new("Frame", {
			Size = UDim2.fromOffset(340, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = DARK,
			BackgroundTransparency = 0.35,
			LayoutOrder = popupCount,
			Parent = feed,
		}, {
			corner(8),
			new("UIPadding", {
				PaddingLeft = UDim.new(0, 10),
				PaddingRight = UDim.new(0, 10),
				PaddingTop = UDim.new(0, 6),
				PaddingBottom = UDim.new(0, 6),
			}),
			new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		text({
			Size = UDim2.new(1, 0, 0, 26),
			TextSize = 24,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = if positive then GOLD else Color3.fromRGB(255, 80, 80),
			Text = string.format("%s%d AURA", if positive then "+" else "", payload.Amount),
			LayoutOrder = 1,
			Parent = entry,
		})
		if payload.Title ~= "" then
			text({
				Size = UDim2.fromScale(1, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextSize = 15,
				TextWrapped = true,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Right,
				Text = payload.Title,
				LayoutOrder = 2,
				Parent = entry,
			})
		end
		for i, tag in ipairs(payload.Tags) do
			text({
				Size = UDim2.new(1, 0, 0, 16),
				TextSize = 12,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = Color3.fromRGB(150, 220, 255),
				Text = tag,
				LayoutOrder = 2 + i,
				Parent = entry,
			})
		end
		fadeOut(entry, 3.5, 0.6)
	end

	-------------------------------------------------------------------------
	-- Big centre banner (boss defeated / rank up) and small announcements
	-------------------------------------------------------------------------
	local currentBanner: Frame? = nil

	function self.banner(title: string, lines: { string }, total: number?, color: Color3)
		if currentBanner then
			currentBanner:Destroy()
		end
		local frame = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.36),
			Size = UDim2.fromOffset(520, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = DARK,
			BackgroundTransparency = 0.2,
			Parent = screen,
		}, {
			corner(12),
			stroke(color, 2),
			new("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12) }),
			new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
		})
		currentBanner = frame
		text({ Size = UDim2.new(1, 0, 0, 40), TextSize = 34, TextColor3 = color, Text = title, LayoutOrder = 0, Parent = frame })
		for i, line in ipairs(lines) do
			text({
				Size = UDim2.new(1, 0, 0, 22),
				TextSize = 17,
				Font = Enum.Font.GothamBold,
				Text = line,
				LayoutOrder = i,
				Parent = frame,
			})
		end
		if total then
			text({
				Size = UDim2.new(1, 0, 0, 44),
				TextSize = 36,
				TextColor3 = GOLD,
				Text = string.format("+%d AURA FARMED", total),
				LayoutOrder = #lines + 1,
				Parent = frame,
			})
		end
		fadeOut(frame, 5.5, 0.8)
	end

	local announceList = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 78),
		Size = UDim2.fromOffset(600, 90),
		BackgroundTransparency = 1,
		Parent = screen,
	}, { new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }) })
	local announceCount = 0

	function self.announce(message: string, color: Color3?)
		announceCount += 1
		local label = text({
			Size = UDim2.new(1, 0, 0, 24),
			TextSize = 18,
			TextColor3 = color or WHITE,
			Text = message,
			LayoutOrder = announceCount,
			Parent = announceList,
		})
		local labels = {}
		for _, child in ipairs(announceList:GetChildren()) do
			if child:IsA("TextLabel") then
				table.insert(labels, child)
			end
		end
		if #labels > 3 then
			table.sort(labels, function(a, b)
				return a.LayoutOrder < b.LayoutOrder
			end)
			labels[1]:Destroy()
		end
		fadeOut(label, 4, 0.6)
	end

	-------------------------------------------------------------------------
	-- Shout box + heroic line list (left side)
	-------------------------------------------------------------------------
	local shoutFrame = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.62, 0),
		Size = UDim2.fromOffset(392, 40),
		BackgroundColor3 = DARK,
		BackgroundTransparency = 0.25,
		Parent = screen,
	}, { corner(8), stroke(GOLD, 1) })
	local box = new("TextBox", {
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.fromOffset(196, 32),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamBold,
		PlaceholderText = "Say something heroic...",
		PlaceholderColor3 = Color3.fromRGB(150, 140, 160),
		Text = "",
		TextColor3 = WHITE,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = shoutFrame,
	})
	local function button(label: string, position: UDim2, size: UDim2, color: Color3, parent: Instance)
		return new("TextButton", {
			Position = position,
			Size = size,
			BackgroundColor3 = color,
			Font = Enum.Font.GothamBlack,
			Text = label,
			TextColor3 = DARK,
			TextSize = 13,
			AutoButtonColor = true,
			Parent = parent,
		}, { corner(6) })
	end
	local shoutButton = button("SHOUT", UDim2.fromOffset(208, 5), UDim2.fromOffset(62, 30), GOLD, shoutFrame)
	local linesButton = button("LINES", UDim2.fromOffset(274, 5), UDim2.fromOffset(50, 30), Color3.fromRGB(150, 220, 255), shoutFrame)
	local classButton = button("CLASS", UDim2.fromOffset(328, 5), UDim2.fromOffset(58, 30), Color3.fromRGB(255, 140, 140), shoutFrame)
	classButton.Activated:Connect(callbacks.onClassButton)

	local function submit()
		local message = box.Text
		if string.match(message, "%S") then
			callbacks.onShout(message)
		end
		box.Text = ""
	end
	shoutButton.Activated:Connect(submit)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submit()
		end
	end)

	local CONDITION_HINTS = {
		FoeLow = "enemy under 25% HP",
		LowHealth = "you under 30% HP",
		AfterDodge = "right after a perfect dodge",
		AfterHit = "right after taking a hit",
		AfterKill = "right after a takedown",
		NoFight = "before a fight",
	}
	local list = new("ScrollingFrame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromOffset(0, -6),
		Size = UDim2.fromOffset(392, 260),
		BackgroundColor3 = DARK,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
		Parent = shoutFrame,
	}, {
		corner(8),
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }),
		new("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
		}),
	})
	text({
		Size = UDim2.new(1, 0, 0, 34),
		TextSize = 12,
		TextWrapped = true,
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.fromRGB(200, 200, 200),
		Text = "Tap a line to load it. x2 in a fight. Saying the same line twice in 30s costs aura!",
		LayoutOrder = 0,
		Parent = list,
	})
	local function buildLines()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local lines = HeroicLines.forSide(Config, side)
		local accent = if side == "Evil" then "#FF7878" else "#FFD76E"
		for i, line in ipairs(lines) do
			local hint = if line.Condition
				then string.format("  (x%s %s)", tostring(line.Bonus), CONDITION_HINTS[line.Condition] or "")
				else ""
			local entry = new("TextButton", {
				Size = UDim2.fromScale(1, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = Color3.fromRGB(45, 38, 58),
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = WHITE,
				RichText = true,
				Text = string.format('<font color="%s">+%d</font>  %s<font color="#96DCFF">%s</font>', accent, line.Aura, line.Text, hint),
				LayoutOrder = i,
				Parent = list,
			}, { corner(6), new("UIPadding", {
				PaddingLeft = UDim.new(0, 6),
				PaddingRight = UDim.new(0, 6),
				PaddingTop = UDim.new(0, 4),
				PaddingBottom = UDim.new(0, 4),
			}) })
			entry.Activated:Connect(function()
				box.Text = line.Text
				list.Visible = false
			end)
		end
	end
	buildLines()

	-- Switch rank names, line list and ultimate label to a class (nil = undecided).
	function self.setClass(class)
		side = if class then class.Side else nil
		ultimateName = if class then class.Ultimate.Name else ""
		box.PlaceholderText = if side == "Evil" then "Say something villainous..." else "Say something heroic..."
		buildLines()
		self.setAura(currentAura)
		self.setStyle(currentStyle)
	end

	linesButton.Activated:Connect(function()
		list.Visible = not list.Visible
	end)

	-------------------------------------------------------------------------
	-- Action buttons (right side, above the mobile jump button)
	-------------------------------------------------------------------------
	local actions = new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -150),
		Size = UDim2.fromOffset(110, 3 * 46),
		BackgroundTransparency = 1,
		Parent = screen,
	}, { new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }) })
	local cooldownBars = {}
	local ACTIONS = {
		{ Name = "Slash", Label = "SLASH [Click]", Color = Color3.fromRGB(210, 235, 255) },
		{ Name = "Dash", Label = "DASH [Q]", Color = Color3.fromRGB(150, 255, 190) },
		{ Name = "Ultimate", Label = "ULT [F]", Color = Color3.fromRGB(255, 140, 80) },
	}
	for i, action in ipairs(ACTIONS) do
		local b = new("TextButton", {
			Size = UDim2.fromOffset(110, 40),
			BackgroundColor3 = action.Color,
			Font = Enum.Font.GothamBlack,
			TextSize = 13,
			TextColor3 = DARK,
			Text = action.Label,
			LayoutOrder = i,
			Parent = actions,
		}, { corner(8) })
		cooldownBars[action.Name] = new("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Parent = b,
		}, { corner(8) })
		b.Activated:Connect(function()
			callbacks.onAction(action.Name)
		end)
	end

	function self.cooldown(actionName: string, seconds: number)
		local bar = cooldownBars[actionName]
		if not bar then
			return
		end
		bar.Size = UDim2.fromScale(1, 1)
		TweenService:Create(bar, TweenInfo.new(seconds, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0, 1) }):Play()
	end

	self.setAura(0)
	self.setStyle(0)
	return self
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="22">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Aura Farm client: input (slash / dash / ultimate), the dash movement,
-- forwarding chat to the server, and feeding the HUD.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))
local ClassPicker = require(script.Parent:WaitForChild("ClassPicker"))
local Hud = require(script.Parent:WaitForChild("Hud"))

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("AuraFarmRemotes")
local ActionRemote = remotes:WaitForChild("Action") :: RemoteEvent
local ShoutRemote = remotes:WaitForChild("Shout") :: RemoteEvent
local NotifyRemote = remotes:WaitForChild("Notify") :: RemoteEvent
local ChooseClassRemote = remotes:WaitForChild("ChooseClass") :: RemoteEvent

-- A stat of the player's class (defaults while undecided). Cooldowns here
-- only stop pointless requests; the server enforces the real ones.
local function stat(key: string): number
	local class = Classes.get(player:GetAttribute("ClassId"))
	return if class then class[key] else Classes.Defaults[key]
end

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function liveCharacter()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil, nil, nil
	end
	return character, humanoid, root :: BasePart
end

---------------------------------------------------------------------------
-- Chat
---------------------------------------------------------------------------

-- Shout box: post to the real chat (so everyone sees it, filtered by
-- Roblox) when TextChatService is in use, and always tell the server
-- directly too. The server ignores duplicates.
local function shout(message: string)
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local channels = TextChatService:FindFirstChild("TextChannels")
			local general = channels and channels:FindFirstChild("RBXGeneral")
			if general then
				(general :: TextChannel):SendAsync(message)
			end
		end
	end)
	ShoutRemote:FireServer(message)
end

-- Messages typed into the normal chat box.
pcall(function()
	TextChatService.SendingMessage:Connect(function(message: TextChatMessage)
		ShoutRemote:FireServer(message.Text)
	end)
end)

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------

local hud
local lastSlash, lastDash, lastUltimate = -math.huge, -math.huge, -math.huge

local function afterimage(root: BasePart)
	local ghost = Instance.new("Part")
	ghost.Anchored = true
	ghost.CanCollide = false
	ghost.CanQuery = false
	ghost.CanTouch = false
	ghost.CastShadow = false
	ghost.Material = Enum.Material.Neon
	ghost.Color = Color3.fromRGB(150, 255, 190)
	ghost.Transparency = 0.5
	ghost.Size = Vector3.new(2, 4.5, 1)
	ghost.CFrame = root.CFrame
	ghost.Parent = workspace
	TweenService:Create(ghost, TweenInfo.new(0.3), { Transparency = 1 }):Play()
	task.delay(0.35, function()
		ghost:Destroy()
	end)
end

local function slash()
	local now = os.clock()
	local cooldown = stat("SlashCooldown")
	if now - lastSlash < cooldown or not liveCharacter() then
		return
	end
	lastSlash = now
	ActionRemote:FireServer("Slash")
	hud.cooldown("Slash", cooldown)
end

-- Pushes the character forward for `duration` seconds at `speed`. With
-- useFacing, it goes the way you're facing; otherwise the way you're moving.
local function lunge(speed: number, duration: number, useFacing: boolean)
	local _, humanoid, root = liveCharacter()
	if not humanoid or not root then
		return
	end
	local direction = if useFacing then root.CFrame.LookVector else humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = root.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.1 then
		return
	end
	direction = direction.Unit
	root.CFrame = CFrame.lookAt(root.Position, root.Position + direction)

	local elapsed, sinceGhost = 0, 0
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		sinceGhost += dt
		if elapsed >= duration or not root.Parent then
			connection:Disconnect()
			return
		end
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(direction.X * speed, math.max(velocity.Y, 0), direction.Z * speed)
		if sinceGhost >= 0.04 then
			sinceGhost = 0
			afterimage(root)
		end
	end)
end

local function dash()
	local now = os.clock()
	local cooldown = stat("DashCooldown")
	if now - lastDash < cooldown or not liveCharacter() then
		return
	end
	lastDash = now
	ActionRemote:FireServer("Dash")
	hud.cooldown("Dash", cooldown)
	lunge(Config.Combat.DashSpeed, Config.Combat.DashDuration, false)
end

local function ultimate()
	local now = os.clock()
	if now - lastUltimate < Config.Combat.UltimateCooldown or not liveCharacter() then
		return
	end
	lastUltimate = now
	ActionRemote:FireServer("Ultimate")
	hud.cooldown("Ultimate", Config.Combat.UltimateCooldown)
end

local ACTIONS = { Slash = slash, Dash = dash, Ultimate = ultimate }

local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
local picker = ClassPicker.new(playerGui, function(classId: string)
	ChooseClassRemote:FireServer(classId)
end)

hud = Hud.new(playerGui, {
	onClassButton = function()
		picker.open(player:GetAttribute("ClassId"))
	end,
	onShout = shout,
	onAction = function(name: string)
		local action = ACTIONS[name]
		if action then
			action()
		end
	end,
})

-- Hold the mouse button (or gamepad trigger) to keep slashing.
local holdingSlash = false
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
		holdingSlash = true
		slash()
	elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonB then
		dash()
	elseif input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonY then
		ultimate()
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
		holdingSlash = false
	end
end)
RunService.Heartbeat:Connect(function()
	if holdingSlash then
		slash()
	end
end)

---------------------------------------------------------------------------
-- HUD feeds
---------------------------------------------------------------------------

task.spawn(function()
	local leaderstats = player:WaitForChild("leaderstats")
	local aura = leaderstats:WaitForChild("Aura") :: IntValue
	hud.setAura(aura.Value)
	aura.Changed:Connect(function(value)
		hud.setAura(value)
	end)
end)

hud.setStyle(player:GetAttribute("Style") or 0)
player:GetAttributeChangedSignal("Style"):Connect(function()
	hud.setStyle(player:GetAttribute("Style") or 0)
end)

task.spawn(function()
	local bosses = workspace:WaitForChild("AuraFarmBosses")
	local function refresh()
		local model = bosses:FindFirstChildWhichIsA("Model")
		hud.setBoss(model)
	end
	bosses.ChildAdded:Connect(refresh)
	bosses.ChildRemoved:Connect(refresh)
	refresh()
end)

-- Class: update the HUD when it changes, and open the picker for new
-- players once their save has loaded.
local function onClassChanged()
	local class = Classes.get(player:GetAttribute("ClassId"))
	hud.setClass(class)
	if class then
		picker.close()
	end
end
player:GetAttributeChangedSignal("ClassId"):Connect(onClassChanged)
onClassChanged()

local function onLoaded()
	if player:GetAttribute("Loaded") and player:GetAttribute("ClassId") == nil and not picker.isOpen() then
		picker.open(nil)
	end
end
player:GetAttributeChangedSignal("Loaded"):Connect(onLoaded)
onLoaded()

NotifyRemote.OnClientEvent:Connect(function(payload)
	if type(payload) ~= "table" then
		return
	end
	if payload.Kind == "Aura" then
		hud.popup(payload)
	elseif payload.Kind == "Banner" then
		hud.banner(payload.Title, payload.Lines, payload.Total, rgb(payload.Color))
	elseif payload.Kind == "RankUp" then
		-- Not a banner: a rank up usually lands together with a boss banner.
		hud.announce("RANK UP!  You are now a " .. payload.Rank, rgb(payload.Color))
	elseif payload.Kind == "Message" then
		hud.announce(payload.Text, Color3.fromRGB(255, 160, 160))
	elseif payload.Kind == "Announce" then
		hud.announce(payload.Text)
	elseif payload.Kind == "PickClass" then
		if not picker.isOpen() then
			picker.open(player:GetAttribute("ClassId"))
		end
	elseif payload.Kind == "ClassChosen" then
		picker.close()
	elseif payload.Kind == "Rush" and type(payload.Distance) == "number" then
		-- The Rush ultimate: carry the character along the line it hit.
		local duration = 0.3
		lunge(payload.Distance / duration, duration, true)
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>