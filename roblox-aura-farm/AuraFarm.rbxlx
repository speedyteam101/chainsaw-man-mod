	{ Id = "DawnBlade", Name = "Dawn Blade", Role = "Duelist", Color = { 255, 200, 150 },
		Description = "Each strike draws strength from the morning sun.",
		MaxHealth = 110, WalkSpeed = 17, SlashDamage = 24, Lifesteal = 0.1,
