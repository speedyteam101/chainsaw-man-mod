      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">AuraMath</string>
          <string name="Source"><![CDATA[--[[
	Rank lookups, style meter maths, boss reward maths and the 2D (top-down)
	geometry used for attack zones.

	Pure Luau (no Roblox APIs) so it can be unit tested outside Roblox.
]]

local AuraMath = {}

-- Highest entry of `ranks` whose Min <= value. Returns rank, index, next rank.
function AuraMath.getRank(value: number, ranks)
	local index = 1
	for i, rank in ipairs(ranks) do
		if value >= rank.Min then
			index = i
		end
	end
	return ranks[index], index, ranks[index + 1]
end

-- 0..1 progress from the current rank to the next (1 at the top rank).
function AuraMath.rankProgress(value: number, ranks): number
	local rank, _, nextRank = AuraMath.getRank(value, ranks)
	if not nextRank then
		return 1
	end
	return math.clamp((value - rank.Min) / (nextRank.Min - rank.Min), 0, 1)
end

-- Style after `dt` seconds, given `sinceGain` seconds since it last went up.
function AuraMath.decayStyle(style: number, sinceGain: number, dt: number, styleConfig): number
	if sinceGain < styleConfig.DecayDelay then
		return style
	end
	return math.max(0, style - styleConfig.DecayPerSecond * dt)
end

--[[
	Aura for one participant when a boss dies.

	flags = { Killer = bool, Flawless = bool, Clutch = bool, CalledIt = bool, Finisher = bool }
	Only the killer can earn Clutch / CalledIt / Finisher. Everyone can earn
	Flawless. Non-killers start from base * assistFraction.

	Returns total (integer) and a breakdown list of label strings.
]]
function AuraMath.defeatReward(base: number, styleRank, flags, bonuses, assistFraction: number)
	local breakdown = {}
	local start = base
	if flags.Killer then
		table.insert(breakdown, string.format("Boss defeated: %d", base))
	else
		start = base * assistFraction
		table.insert(breakdown, string.format("Assist: %d", math.floor(start + 0.5)))
	end

	local bonusTotal = 0
	local order = { "Flawless", "Clutch", "CalledIt", "Finisher" }
	for _, key in ipairs(order) do
		local killerOnly = key ~= "Flawless"
		if flags[key] and (flags.Killer or not killerOnly) then
			bonusTotal += bonuses[key].Bonus
			table.insert(breakdown, string.format("%s  +%d%%", bonuses[key].Label, math.floor(bonuses[key].Bonus * 100 + 0.5)))
		end
	end

	if styleRank.Multiplier ~= 1 then
		table.insert(breakdown, string.format("STYLE %s  x%s", styleRank.Name, tostring(styleRank.Multiplier)))
	end

	local total = math.floor(start * styleRank.Multiplier * (1 + bonusTotal) + 0.5)
	return total, breakdown
end

---------------------------------------------------------------------------
-- Top-down geometry (x/z plane)
---------------------------------------------------------------------------

function AuraMath.inCircle(px: number, pz: number, cx: number, cz: number, radius: number): boolean
	local dx, dz = px - cx, pz - cz
	return dx * dx + dz * dz <= radius * radius
end

-- Rectangle starting at (ox, oz), running `length` along the unit direction
-- (dirX, dirZ), `width` wide (centred on that line).
function AuraMath.inRect(
	px: number,
	pz: number,
	ox: number,
	oz: number,
	dirX: number,
	dirZ: number,
	length: number,
	width: number
): boolean
	local rx, rz = px - ox, pz - oz
	local along = rx * dirX + rz * dirZ
	local across = math.abs(rx * -dirZ + rz * dirX)
	return along >= 0 and along <= length and across <= width / 2
end

-- One "walking away without looking back" sample: facing away from the
-- explosion and actually getting further from it. movedAway is how much the
-- distance to the explosion grew since the last sample, in studs.
function AuraMath.isWalkingAway(lookX: number, lookZ: number, toBossX: number, toBossZ: number, movedAway: number): boolean
	local length = math.sqrt(toBossX * toBossX + toBossZ * toBossZ)
	if length < 1e-3 or movedAway < 0.5 then
		return false
	end
	local dot = (lookX * toBossX + lookZ * toBossZ) / length
	return dot < -0.3
end

return AuraMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Every tunable number in Aura Farm lives here.

	This module is plain Luau (no Roblox types) so the pure game logic can be
	unit tested outside Roblox. Colors are {R, G, B} arrays (0-255).
]]

local Config = {}

---------------------------------------------------------------------------
-- Aura ranks (lowest first). You hold the highest rank whose Min you meet.
---------------------------------------------------------------------------
Config.Ranks = {
	{ Name = "NPC", Min = 0, Color = { 170, 170, 170 } },
	{ Name = "Background Character", Min = 100, Color = { 120, 200, 255 } },
	{ Name = "Side Character", Min = 500, Color = { 90, 255, 160 } },
	{ Name = "Rival", Min = 1500, Color = { 255, 230, 80 } },
	{ Name = "Main Character", Min = 4000, Color = { 255, 150, 40 } },
	{ Name = "Protagonist", Min = 10000, Color = { 255, 70, 70 } },
	{ Name = "Legend", Min = 25000, Color = { 200, 90, 255 } },
	{ Name = "Aura God", Min = 60000, Color = { 255, 255, 255 } },
}

---------------------------------------------------------------------------
-- Heroic lines.
--   Aura:      base aura for saying it.
--   Condition: optional situation that makes it hit much harder:
--     "BossLow"    the boss you're fighting is below 25% health
--     "LowHealth"  you are below 30% health
--     "AfterDodge" you perfect-dodged in the last 4 seconds
--     "AfterHit"   you took a hit in the last 4 seconds
--     "NoBoss"     no boss is active (pre-fight trash talk)
--   Bonus:     multiplier applied when the Condition is met.
---------------------------------------------------------------------------
Config.HeroicLines = {
	{ Id = "notHere", Text = "I won't lose. Not here. Not now.", Aura = 15, Condition = "LowHealth", Bonus = 3 },
	{ Id = "standBack", Text = "Stand back. I'll handle this.", Aura = 10, Condition = "NoBoss", Bonus = 2 },
	{ Id = "wrongHero", Text = "You picked the wrong hero to fight.", Aura = 20 },
	{ Id = "friends", Text = "My friends are my power!", Aura = 15 },
	{ Id = "endsNow", Text = "This ends now.", Aura = 10, Condition = "BossLow", Bonus = 4 },
	{ Id = "thatsAll", Text = "Is that all you've got?", Aura = 15, Condition = "AfterHit", Bonus = 3 },
	{ Id = "neverBackDown", Text = "I never back down.", Aura = 10 },
	{ Id = "getBackUp", Text = "Even if I fall, I'll get back up.", Aura = 20, Condition = "LowHealth", Bonus = 2 },
	{ Id = "beyondLimits", Text = "Today, I go beyond my limits!", Aura = 25 },
	{ Id = "yourMistake", Text = "You hurt the people I care about. That was your mistake.", Aura = 30 },
	{ Id = "notTrying", Text = "I'm not even trying yet.", Aura = 25, Condition = "AfterDodge", Bonus = 2 },
	{ Id = "getBehindMe", Text = "Get behind me.", Aura = 10, Condition = "NoBoss", Bonus = 2 },
	{ Id = "fightForAll", Text = "I fight for everyone who can't.", Aura = 25 },
	{ Id = "rememberName", Text = "Remember my name.", Aura = 20, Condition = "BossLow", Bonus = 3 },
	{ Id = "oneMoreRound", Text = "One more round.", Aura = 10, Condition = "LowHealth", Bonus = 3 },
	{ Id = "heroShowsUp", Text = "The hero always shows up.", Aura = 15, Condition = "NoBoss", Bonus = 2 },
	{ Id = "myTurn", Text = "It's my turn now.", Aura = 15, Condition = "AfterDodge", Bonus = 3 },
	{ Id = "nothingStops", Text = "Nothing can stop me.", Aura = 15 },
	{ Id = "cameThisFar", Text = "I didn't come this far to quit.", Aura = 20, Condition = "LowHealth", Bonus = 2 },
	{ Id = "watchClosely", Text = "Watch closely. This is how it's done.", Aura = 25, Condition = "BossLow", Bonus = 2 },
	{ Id = "tooSlow", Text = "Too slow.", Aura = 10, Condition = "AfterDodge", Bonus = 4 },
	{ Id = "barelyScratch", Text = "That barely scratched me.", Aura = 15, Condition = "AfterHit", Bonus = 3 },
}

-- A message counts as a heroic line when at least this fraction of the
-- line's words appear in it (so small typos / missing words still count).
Config.LineMatchThreshold = 0.75

-- Freestyle: a message that isn't a known line but uses heroic words still
-- earns a little aura (per keyword, capped). Needs at least MinKeywords.
Config.Freestyle = {
	MinKeywords = 2,
	AuraPerKeyword = 4,
	MaxAura = 16,
	Keywords = {
		"protect", "never", "hero", "friends", "believe", "destiny", "promise",
		"power", "fight", "limit", "limits", "end", "defeat", "win", "strong",
		"stronger", "courage", "justice", "everyone", "unstoppable", "legend",
		"rise", "stand", "glory", "brave", "fear", "surrender",
	},
}

-- Saying anything heroic while a boss is active multiplies its aura.
Config.BossFightLineMultiplier = 2
-- Ignore heroic messages sent closer together than this (anti-spam), seconds.
Config.LineGlobalCooldown = 2.5
-- Repeating the same line within this window costs aura instead ("cringe").
Config.LineRepeatWindow = 30
Config.LineRepeatPenalty = 15
-- How long the line floats over your head, seconds.
Config.SpeechDuration = 3.5

---------------------------------------------------------------------------
-- Style meter (0-100). Fighting cool fills it, getting hit drains it.
---------------------------------------------------------------------------
Config.Style = {
	Max = 100,
	PerHit = 5,
	PerPerfectDodge = 18,
	PerHeroicLineInFight = 10,
	LostWhenHit = 35,
	DecayDelay = 3, -- seconds without gaining style before it decays
	DecayPerSecond = 6,
	-- Letter ranks (lowest first): reached when Style >= Min.
	Ranks = {
		{ Name = "D", Min = 0, Multiplier = 1 },
		{ Name = "C", Min = 20, Multiplier = 1.2 },
		{ Name = "B", Min = 40, Multiplier = 1.4 },
		{ Name = "A", Min = 60, Multiplier = 1.7 },
		{ Name = "S", Min = 80, Multiplier = 2 },
		{ Name = "SSS", Min = 100, Multiplier = 3 },
	},
}

---------------------------------------------------------------------------
-- Player combat
---------------------------------------------------------------------------
Config.Combat = {
	SlashDamage = 22,
	SlashCooldown = 0.35,
	SlashRange = 9, -- studs from your body to the boss's edge
	AuraPerHit = 1, -- multiplied by your style rank multiplier, rounded

	DashCooldown = 1.2,
	DashSpeed = 95,
	DashDuration = 0.18, -- how long the client pushes you forward
	DashInvulnerability = 0.45, -- i-frames, seconds
	PerfectDodgeWindow = 0.6, -- dash this close before an impact = perfect dodge
	PerfectDodgeAura = 15,

	UltimateStyleCost = 80, -- needs S rank or higher; spends this much style
	UltimateDamageFraction = 0.12, -- of the boss's max health...
	UltimateFlatDamage = 150, -- ...plus this
	UltimateRange = 30,
	UltimateCooldown = 3,

	DeathAuraLoss = 20, -- dying in a boss fight ("took the L")
}

---------------------------------------------------------------------------
-- Boss defeat bonuses. Bonuses add together, then multiply the base reward:
--   reward = Reward * styleMultiplier * (1 + sum of bonuses)
---------------------------------------------------------------------------
Config.DefeatBonuses = {
	Flawless = { Label = "FLAWLESS (no damage taken)", Bonus = 1.0 },
	Clutch = { Label = "CLUTCH (final blow under 25% HP)", Bonus = 0.75 },
	CalledIt = { Label = "CALLED IT (heroic line right before the kill)", Bonus = 0.5 },
	Finisher = { Label = "FINISHER (killed with your ultimate)", Bonus = 0.5 },
}
Config.ClutchHealthFraction = 0.25
Config.CalledItWindow = 6 -- seconds between your line and the killing blow
-- Participants who didn't land the kill get this fraction of the base reward.
Config.AssistFraction = 0.6

-- After a kill, walk away from the explosion without looking back.
Config.WalkAway = {
	Label = "DIDN'T LOOK BACK",
	Aura = 50,
	Duration = 2.5, -- seconds you must keep walking away
	SampleInterval = 0.25,
	RequiredFraction = 0.8, -- of samples that must be "walking away"
}

---------------------------------------------------------------------------
-- Bosses. Attacks: "Slam" (circle around the boss), "Charge" (line toward
-- the target), "Barrage" (circles under every fighter).
---------------------------------------------------------------------------
Config.Bosses = {
	{
		Id = "Brute",
		Name = "Grand Brute",
		Title = "The Wall That Hits Back",
		MaxHealth = 700,
		Reward = 120,
		Size = 9,
		Speed = 10,
		Color = { 120, 85, 60 },
		EyeColor = { 255, 60, 30 },
		Attacks = { "Slam", "Charge" },
		AttackInterval = 3.2,
		Windup = 1.1,
		Damage = 25,
		Cooldown = 20, -- seconds before this altar can be used again
	},
	{
		Id = "Storm",
		Name = "Storm Tyrant",
		Title = "Lord of the Grey Sky",
		MaxHealth = 1800,
		Reward = 350,
		Size = 11,
		Speed = 13,
		Color = { 60, 70, 110 },
		EyeColor = { 120, 220, 255 },
		Attacks = { "Slam", "Charge", "Barrage" },
		AttackInterval = 2.7,
		Windup = 0.95,
		Damage = 30,
		Cooldown = 30,
	},
	{
		Id = "Rival",
		Name = "The Final Rival",
		Title = "The One Who Was Always Stronger",
		MaxHealth = 3600,
		Reward = 900,
		Size = 8,
		Speed = 17,
		Color = { 25, 25, 30 },
		EyeColor = { 200, 80, 255 },
		Attacks = { "Slam", "Charge", "Barrage" },
		AttackInterval = 2.3,
		Windup = 0.85,
		Damage = 35,
		Cooldown = 45,
		EnrageAt = 0.5, -- below this health fraction, attacks speed up
		EnrageSpeedup = 0.7, -- windup and interval multiply by this
	},
}

Config.Attacks = {
	Slam = { Radius = 16 },
	Charge = { Length = 60, Width = 10, Duration = 0.45 },
	Barrage = { Radius = 8 },
}

-- The boss gives up and leaves if nobody is fighting it for this long.
Config.BossLeashTime = 12
-- Fighters must be within this distance of the arena centre.
Config.ArenaRadius = 90

---------------------------------------------------------------------------
-- Saving
---------------------------------------------------------------------------
Config.DataStoreName = "AuraFarm_v1"
Config.AutosaveInterval = 120

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">HeroicLines</string>
          <string name="Source"><![CDATA[--[[
	Decides how much aura a chat message is worth.

	Pure Luau (no Roblox APIs) so it can be unit tested outside Roblox; all
	tuning comes in through the `config` argument (see Config.lua).
]]

local HeroicLines = {}

-- Lowercase, drop apostrophes ("you've" -> "youve"), turn everything that
-- isn't a letter or digit into a space, collapse runs of spaces.
function HeroicLines.normalize(text: string): string
	local s = string.lower(text)
	s = string.gsub(s, "\226\128\153", "") -- curly apostrophe (UTF-8 E2 80 99)
	s = string.gsub(s, "'", "")
	s = string.gsub(s, "[^%w]+", " ")
	s = string.gsub(s, "^%s+", "")
	s = string.gsub(s, "%s+$", "")
	return s
end

function HeroicLines.words(text: string): { string }
	local out = {}
	for word in string.gmatch(HeroicLines.normalize(text), "%S+") do
		table.insert(out, word)
	end
	return out
end

local function wordSet(words: { string }): { [string]: boolean }
	local set = {}
	for _, w in ipairs(words) do
		set[w] = true
	end
	return set
end

-- Fraction of the line's unique words that appear in the message (0..1).
function HeroicLines.similarity(messageWords: { string }, lineText: string): number
	local lineWords = HeroicLines.words(lineText)
	local unique = wordSet(lineWords)
	local messageSet = wordSet(messageWords)
	local total, found = 0, 0
	for w in pairs(unique) do
		total += 1
		if messageSet[w] then
			found += 1
		end
	end
	if total == 0 then
		return 0
	end
	return found / total
end

-- Best matching heroic line, or nil. A message far longer than the line
-- (e.g. every line pasted at once) never matches.
function HeroicLines.match(message: string, lines, threshold: number)
	local messageWords = HeroicLines.words(message)
	if #messageWords == 0 then
		return nil, 0
	end
	local best, bestScore, bestLength = nil, 0, 0
	for _, line in ipairs(lines) do
		local lineLength = #HeroicLines.words(line.Text)
		if #messageWords <= lineLength * 2 + 3 then
			local score = HeroicLines.similarity(messageWords, line.Text)
			if score >= threshold and (score > bestScore or (score == bestScore and lineLength > bestLength)) then
				best, bestScore, bestLength = line, score, lineLength
			end
		end
	end
	return best, bestScore
end

-- Aura for an unscripted message made of heroic words, and how many
-- different keywords it used.
function HeroicLines.freestyle(message: string, freestyleConfig): (number, number)
	local messageSet = wordSet(HeroicLines.words(message))
	local count = 0
	for _, keyword in ipairs(freestyleConfig.Keywords) do
		if messageSet[keyword] then
			count += 1
		end
	end
	if count < freestyleConfig.MinKeywords then
		return 0, count
	end
	return math.min(count * freestyleConfig.AuraPerKeyword, freestyleConfig.MaxAura), count
end

--[[
	context = {
		inBossFight: boolean,
		healthFraction: number,      -- the speaker's health, 0..1
		bossHealthFraction: number?, -- nil when no boss is active
		sinceDodge: number,          -- seconds since the last perfect dodge
		sinceHit: number,            -- seconds since the speaker was last hit
	}
]]
function HeroicLines.conditionMet(condition: string?, context): boolean
	if condition == nil then
		return false
	elseif condition == "BossLow" then
		return context.bossHealthFraction ~= nil and context.bossHealthFraction < 0.25
	elseif condition == "LowHealth" then
		return context.healthFraction < 0.3
	elseif condition == "AfterDodge" then
		return context.sinceDodge <= 4
	elseif condition == "AfterHit" then
		return context.sinceHit <= 4
	elseif condition == "NoBoss" then
		return not context.inBossFight
	end
	return false
end

local CONDITION_LABELS = {
	BossLow = "BOSS ON ITS LAST LEGS",
	LowHealth = "LOW HP",
	AfterDodge = "AFTER A PERFECT DODGE",
	AfterHit = "SHRUGGED IT OFF",
	NoBoss = "PRE-FIGHT",
}

--[[
	Scores a message. Doesn't change any state: the caller records
	history[result.historyKey] = now when result.historyKey is set.

	history: { [string]: number } -- key -> last time it was said
	Returns {
		kind = "Line" | "Freestyle" | "Repeat" | "None",
		line = <line table>?, amount = number, tags = { string },
		historyKey = string?,
	}
]]
function HeroicLines.evaluate(message: string, context, config, history, now: number)
	local line = HeroicLines.match(message, config.HeroicLines, config.LineMatchThreshold)
	local tags = {}
	local amount
	local historyKey

	if line then
		historyKey = "line:" .. line.Id
		amount = line.Aura
		if line.Condition and HeroicLines.conditionMet(line.Condition, context) then
			amount *= line.Bonus
			table.insert(tags, string.format("%s x%s", CONDITION_LABELS[line.Condition], tostring(line.Bonus)))
		end
	else
		local freestyleAura = HeroicLines.freestyle(message, config.Freestyle)
		if freestyleAura <= 0 then
			return { kind = "None", amount = 0, tags = tags }
		end
		historyKey = "free:" .. HeroicLines.normalize(message)
		amount = freestyleAura
		table.insert(tags, "FREESTYLE")
	end

	local last = history[historyKey]
	if last and now - last < config.LineRepeatWindow then
		return {
			kind = "Repeat",
			line = line,
			amount = -config.LineRepeatPenalty,
			tags = { "CRINGE: YOU ALREADY SAID THAT" },
			historyKey = historyKey,
		}
	end

	if context.inBossFight then
		amount *= config.BossFightLineMultiplier
		table.insert(tags, string.format("BOSS FIGHT x%s", tostring(config.BossFightLineMultiplier)))
	end

	return {
		kind = if line then "Line" else "Freestyle",
		line = line,
		amount = math.floor(amount + 0.5),
		tags = tags,
		historyKey = historyKey,
	}
end

return HeroicLines
]]></string>
        </Properties>
      </Item>
    </Item>
